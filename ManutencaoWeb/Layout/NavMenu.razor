@using Microsoft.AspNetCore.Components.Authorization
@using ManutencaoWeb.Services

@inject SessaoService Sessao
@inject Supabase.Client Supabase
@inject NavigationManager Nav

<nav class="sidebar @(IsMenuOpen ? "mobile-open" : "")">

    <div class="sidebar-brand">
        <i class="bi bi-gear-wide">
            <span> Manutenção WEB</span>
        </i>
    </div>

    <ul class="sidebar-menu">

        <AuthorizeView Roles="Mecanico,Aprovisionador,Admin">
            <Authorized>
                <li>
                    <a href="/">
                        <i class="bi bi-house-door"></i>
                        <span>Home</span>
                    </a>
                </li>
            </Authorized>
        </AuthorizeView>

        <!-- APROVISIONADOR / ADMIN -->
        <AuthorizeView Roles="Aprovisionador,Admin">
            <Authorized>

                <li>
                    <a href="/requisicoes">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Requisições</span>
                    </a>
                </li>

                <li>
                    <a href="/relatorios">
                        <i class="bi bi-bar-chart"></i>
                        <span>Relatórios</span>
                    </a>
                </li>

                <li>
                    <a href="/liberados">
                        <i class="bi bi-wrench-adjustable"></i>
                        <span>Liberados</span>
                    </a>
                </li>

            </Authorized>
        </AuthorizeView>

        <!-- ADMIN -->
        <AuthorizeView Roles="Admin">
            <Authorized>

                <li>
                    <a href="/admin">
                        <i class="bi bi-plus-square"></i>
                        <span>Cadastros Base</span>
                    </a>
                </li>

                <li>
                    <a href="/gestao-senhas">
                        <i class="bi bi-shield-lock"></i>
                        <span>Gestão de Senhas</span>
                    </a>
                </li>

            </Authorized>
        </AuthorizeView>

    </ul>

    <div class="sidebar-footer">

        <div class="d-flex align-items-center gap-2 mb-3 px-2">

            <div class="user-avatar">
                @Sessao.Iniciais
            </div>

            <div style="font-size: 12px; color: #cfdcd4;">
                <strong>@Sessao.NomeUsuario</strong>
            </div>

        </div>

        <button class="btn-sair" @onclick="Sair">

            <i class="bi bi-box-arrow-right"></i>

            <span>Sair</span>

        </button>

    </div>

</nav>

@code {
    [Parameter]
    public bool IsMenuOpen { get; set; }

    private async Task Sair()
    {
        await Supabase.Auth.SignOut();
        Sessao.Logout();
        Nav.NavigateTo("/login");
    }

}
