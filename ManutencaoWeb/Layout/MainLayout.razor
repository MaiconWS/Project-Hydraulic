@inherits LayoutComponentBase
@using ManutencaoWeb.Services
@inject SessaoService Sessao
@inject NavigationManager Nav

@code {
    private bool isMenuOpen;
    private string caminhoAtual = string.Empty;

    private bool EstaNaPaginaTrocaSenha =>
        string.Equals(caminhoAtual, "alterar-senha", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void FecharMenu()
    {
        isMenuOpen = false;
    }

    protected override Task OnParametersSetAsync()
    {
        caminhoAtual = Nav.ToBaseRelativePath(Nav.Uri)
            .Split('?', '#')[0]
            .TrimEnd('/');

        if (Sessao.ExigeTrocaSenha &&
            !EstaNaPaginaTrocaSenha)
        {
            Nav.NavigateTo("/alterar-senha", replace: true);
        }

        return Task.CompletedTask;
    }
}

<div class="dashboard-wrapper">

    @if (isMenuOpen)
    {
        <button class="mobile-menu-backdrop"
                type="button"
                aria-label="Fechar menu"
                @onclick="FecharMenu"></button>
    }

    <NavMenu IsMenuOpen="@isMenuOpen" OnNavigate="FecharMenu" />

    <main class="main-content">

        <header class="top-bar">

            <div class="top-left d-flex align-items-center">

                <button class="menu-toggle d-md-none me-2"
                        aria-label="@(isMenuOpen ? "Fechar menu" : "Abrir menu")"
                        aria-expanded="@isMenuOpen"
                        aria-controls="app-sidebar"
                        @onclick="ToggleMenu">

                    <i class="bi bi-list"></i>

                </button>

                <span class="user-greeting">

                    Olá, <strong>@Sessao.NomeUsuario!</strong>

                </span>

            </div>

            <div class="top-right">

                <div class="user-avatar">
                    @(Sessao.Iniciais)
                </div>

            </div>

        </header>

        <div class="content-body">
            @if (Sessao.ExigeTrocaSenha && !EstaNaPaginaTrocaSenha)
            {
                <div class="alert alert-warning" role="alert">
                    Antes de continuar, defina uma nova senha para sua conta.
                </div>
            }
            else
            {
                @Body
            }

        </div>

    </main>

</div>
