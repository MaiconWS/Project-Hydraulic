@code {
    // =========================================
    // PROTEÇÃO DA ROTA
    // =========================================

    protected override void OnInitialized()
    {
        if (!Sessao.EstaLogado)
        {
            Nav.NavigateTo("/login");
        }
    }


    // =========================================
    // NAVEGAÇÃO
    // =========================================

    private void IrParaModelos(string categoria)
    {
        Nav.NavigateTo(
            $"/modelos/{Uri.EscapeDataString(categoria)}"
        );
    }


    // =========================================
    // LOGOUT
    // =========================================

    private void Sair()
    {
        Sessao.Logout();

        Nav.NavigateTo("/login");
    }

}
