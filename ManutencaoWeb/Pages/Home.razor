@page "/"
@inject NavigationManager Nav
@using ManutencaoWeb.Services
@inject SessaoService Sessao

<PageTitle>Home - ManutencaoWeb</PageTitle>

<div class="dashboard-wrapper">

    <!-- =========================================
         SIDEBAR
         ========================================= -->

    <nav class="sidebar @(isMenuOpen ? "mobile-open" : "")">

        <div class="sidebar-brand">
            <i class="bi bi-gear-wide"><span> CRR</span></i>
        </div>
        <ul class="sidebar-menu">
            <li class="active">
                <a href="/">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>

            <li>
                <a href="/requisicoes">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Requisições</span>
                </a>
            </li>
            <li>
                <a href="/relatorios">
                    <i class="bi bi-bar-chart"></i>
                    <span>Relatórios</span>
                </a>
            </li>
            <li>
                <a href="/liberados">
                    <i class="bi bi-check-all"></i>
                    <span>Concluídas</span>
                </a>
            </li>
            @if (Sessao.IsAdmin)
            {
                <li>
                    <a href="/admin">
                        <i class="bi bi-plus-square"></i>
                        <span>Cadastros Base</span>
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center gap-2 mb-3 px-2">
                <div class="user-avatar">@(Sessao.Iniciais)</div>
                <div style="font-size: 12px; color: #cfdcd4;">
                    <strong>@Sessao.NomeUsuario</strong><br/>
                </div>
            </div>
            
            <button class="btn-sair" @onclick="Sair">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sair</span>
            </button>
        </div>

    </nav>

    <!-- =========================================
         CONTEÚDO PRINCIPAL
         ========================================= -->

    <main class="main-content">

        <!-- =====================================
             TOP BAR
             ===================================== -->

        <header class="top-bar">

            <div class="top-left d-flex align-items-center">
                <button class="menu-toggle d-md-none me-2" @onclick="ToggleMenu">
                    <i class="bi bi-list"></i>
                </button>

                <span class="user-greeting">
                    Olá, <strong>@Sessao.NomeUsuario!</strong>
                </span>
            </div>

            <div class="top-right">
                <div class="user-avatar">
                    @(Sessao.Iniciais)
                </div>
            </div>

        </header>

        <!-- =====================================
             CORPO
             ===================================== -->

        <div class="content-body">

            <div class="section-title mb-4">
                <h2>Categoria de Componentes</h2>
                <p>Selecione uma categoria para continuar sua requisição.</p>
            </div>

            <!-- =================================
                 CATEGORIAS
                 ================================= -->

            <div class="row g-4 mb-5">

                <!-- BOMBA -->
                <div class="col-md-4">
                    <div class="category-card" @onclick="@(() => IrParaModelos("Bomba Hidráulica"))">
                        <div class="card-icon">
                            <i class="bi bi-gear-wide"></i>
                        </div>
                        <h5>Bombas Hidráulicas</h5>
                        <p>Componentes de bombas hidráulicas e acessórios.</p>
                        <span class="card-link">Acessar categoria <i class="bi bi-arrow-right"></i></span>
                    </div>
                </div>

                <!-- MOTOR -->
                <div class="col-md-4">
                    <div class="category-card" @onclick="@(() => IrParaModelos("Motor Hidráulico"))">
                        <div class="card-icon">
                            <i class="bi bi-gear-wide"></i>
                        </div>
                        <h5>Motores Hidráulicos</h5>
                        <p>Componentes de motores hidráulicos e acessórios.</p>
                        <span class="card-link">Acessar categoria <i class="bi bi-arrow-right"></i></span>
                    </div>
                </div>

                <!-- CILINDRO -->
                <div class="col-md-4">
                    <div class="category-card" @onclick="@(() => IrParaModelos("cilindros"))">
                        <div class="card-icon">
                            <i class="bi bi-gear-wide"></i>
                        </div>
                        <h5>Cilindros Hidráulicos</h5>
                        <p>Componentes de cilindros hidráulicos e acessórios.</p>
                        <span class="card-link">Acessar categoria <i class="bi bi-arrow-right"></i></span>
                    </div>
                </div>

            </div>
        </div>
    </main>
</div>

@code {
    private bool isMenuOpen = false;
    
    // Proteção de rota: Verifica se o usuário está logado ao carregar a página
    protected override void OnInitialized()
    {
        if (!Sessao.EstaLogado)
        {
            Nav.NavigateTo("/login");
        }
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void IrParaModelos(string categoria)
    {
        Nav.NavigateTo($"/modelos/{Uri.EscapeDataString(categoria)}");
    }

    private void Sair()
    {
        Sessao.Logout();
        Nav.NavigateTo("/login");
    }
}