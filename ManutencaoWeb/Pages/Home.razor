@page "/"
@inject NavigationManager Nav

<PageTitle>Home - ManutencaoWeb</PageTitle>

<div class="dashboard-wrapper">

    <!-- =========================================
         SIDEBAR
         ========================================= -->

    <nav class="sidebar @(isMenuOpen ? "mobile-open" : "")">

        <div class="sidebar-brand">
            <i class="bi bi-gear-wide"><span> CRR</span></i>
        </div>

        <ul class="sidebar-menu">

            <li class="active">
                <a href="/">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>

            <li>
                <a href="/requisicoes">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Requisições</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <i class="bi bi-box-seam"></i>
                    <span>Peças</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <i class="bi bi-archive"></i>
                    <span>Estoque</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <i class="bi bi-bar-chart"></i>
                    <span>Relatórios</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <i class="bi bi-gear"></i>
                    <span>Configurações</span>
                </a>
            </li>

        </ul>

        <div class="sidebar-footer">

            <button class="btn-sair" @onclick="Sair">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sair</span>
            </button>

        </div>

    </nav>


    <!-- =========================================
         CONTEÚDO PRINCIPAL
         ========================================= -->

    <main class="main-content">


        <!-- =====================================
             TOP BAR
             ===================================== -->

        <header class="top-bar">

            <div class="top-left d-flex align-items-center">

                <button class="menu-toggle d-md-none me-2" @onclick="ToggleMenu">
                    <i class="bi bi-list"></i>
                </button>

                <span class="user-greeting">
                    Olá, <strong>Colaborador!</strong>
                </span>

            </div>


            <div class="top-right">

                <div class="dark-mode">
                    <!--<i class="bi bi-moon"></i> -->
                    <!-- <span>Modo noite</span> -->
                </div>

                <div class="user-avatar">
                    <i class="bi bi-person"></i>
                </div>

            </div>

        </header>


        <!-- =====================================
             CORPO
             ===================================== -->

        <div class="content-body">

            <div class="section-title">

                <h2>
                    Categoria de Componentes
                </h2>

                <p>
                    Selecione uma categoria para continuar sua requisição.
                </p>

            </div>


            <!-- =================================
                 CATEGORIAS
                 ================================= -->

            <div class="row g-4 mb-5">


                <!-- BOMBA -->

                <div class="col-md-4">

                    <div class="category-card"
                         @onclick="@(() => IrParaModelos("Bomba Hidráulica"))">

                        <div class="card-icon">

                            <i class="bi bi-gear-wide"></i>

                        </div>

                        <h5>
                            Bombas Hidráulicas
                        </h5>

                        <p>
                            Componentes de bombas hidráulicas
                            e acessórios.
                        </p>

                        <span class="card-link">
                            Acessar categoria
                            <i class="bi bi-arrow-right"></i>
                        </span>

                    </div>

                </div>


                <!-- MOTOR -->

                <div class="col-md-4">

                    <div class="category-card"
                         @onclick="@(() => IrParaModelos("Motor Hidráulico"))">

                        <div class="card-icon">

                            <i class="bi bi-gear-wide"></i>

                        </div>

                        <h5>
                            Motores Hidráulicos
                        </h5>

                        <p>
                            Componentes de motores hidráulicos
                            e acessórios.
                        </p>

                        <span class="card-link">
                            Acessar categoria
                            <i class="bi bi-arrow-right"></i>
                        </span>

                    </div>

                </div>


                <!-- CILINDRO -->

                <div class="col-md-4">

                    <div class="category-card"
                         @onclick="@(() => IrParaModelos("cilindros"))">

                        <div class="card-icon">

                            <i class="bi bi-gear-wide"></i>

                        </div>

                        <h5>
                            Cilindros Hidráulicos
                        </h5>

                        <p>
                            Componentes de cilindros hidráulicos
                            e acessórios.
                        </p>

                        <span class="card-link">
                            Acessar categoria
                            <i class="bi bi-arrow-right"></i>
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================
                 ACESSO RÁPIDO
                 ================================= -->

            <div class="quick-access-section">

                <h5 class="quick-title">
                    Acesso rápido
                </h5>


                <div class="row g-3">


                    <!-- NOVA REQUISIÇÃO -->

                    <div class="col-md-3">

                        <div class="quick-card">

                            <div class="quick-icon">

                                <i class="bi bi-clipboard-plus"></i>

                            </div>

                            <div>

                                <strong>
                                    Nova requisição
                                </strong>

                                <small>
                                    Criar nova requisição
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- BUSCAR PEÇAS -->

                    <div class="col-md-3">

                        <div class="quick-card">

                            <div class="quick-icon">

                                <i class="bi bi-search"></i>

                            </div>

                            <div>

                                <strong>
                                    Buscar peças
                                </strong>

                                <small>
                                    Pesquise por código ou nome
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- ESTOQUE -->

                    <div class="col-md-3">

                        <div class="quick-card">

                            <div class="quick-icon">

                                <i class="bi bi-boxes"></i>

                            </div>

                            <div>

                                <strong>
                                    Ver estoque
                                </strong>

                                <small>
                                    Consulte a disponibilidade
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- REQUISIÇÕES -->

                    <div class="col-md-3">

                        <div class="quick-card">

                            <div class="quick-icon">

                                <i class="bi bi-clock-history"></i>

                            </div>

                            <div>

                                <strong>
                                    Minhas requisições
                                </strong>

                                <small>
                                    Acompanhe o status
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>


@code {
    // Variáveis e método para controlar a abertura do menu mobile
    private bool isMenuOpen = false;
    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void IrParaModelos(string categoria)
    {
        Nav.NavigateTo(
            $"/modelos/{Uri.EscapeDataString(categoria)}"
        );
    }

    private void Sair()
    {
        Nav.NavigateTo("/");
    }
}