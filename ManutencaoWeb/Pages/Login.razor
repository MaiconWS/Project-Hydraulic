@page "/login"

@using ManutencaoWeb.Services

@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject SupabaseAuthenticationStateProvider AuthStateProvider
@inject SessaoService Sessao

<PageTitle>Login - ManutencaoWeb</PageTitle>

<div class="login-container">

    <div class="login-card shadow-lg">

        <div class="text-center mb-4">

            <h2 class="fw-bold" style="color: #2c3e35;">
                MANUTENÇÃO
                <span class="text-success">WEB</span>
            </h2>

            <p class="text-muted">
                Faça login para acessar o sistema
            </p>

        </div>

        <!-- E-MAIL -->

        <div class="mb-3">

            <label class="form-label fw-bold">
                E-mail
            </label>

            <input type="email"
                   class="form-control py-2"
                   @bind="email"
                   placeholder="Digite seu e-mail"
                   autocomplete="username"
                   disabled="@isLoading" />

        </div>

        <!-- SENHA -->

        <div class="mb-4">

            <label class="form-label fw-bold">
                Senha
            </label>

            <input type="password"
                   class="form-control py-2"
                   @bind="senha"
                   placeholder="Digite sua senha"
                   autocomplete="current-password"
                   disabled="@isLoading" />

        </div>

        <!-- ERRO -->

        @if (!string.IsNullOrWhiteSpace(mensagemErro))
        {
            <div class="alert alert-danger" role="alert">
                @mensagemErro
            </div>
        }

        <!-- BOTÃO -->

        <button class="btn btn-success w-100 py-3 fw-bold mb-3"
                @onclick="FazerLogin"
                disabled="@isLoading">

            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>

                <span>
                    Entrando...
                </span>
            }
            else
            {
                <span>
                    Entrar
                </span>
            }

        </button>

    </div>

</div>

@code {

    private string email = "";
    private string senha = "";

    private bool isLoading = false;

    private string mensagemErro = "";

    // ============================================================
    // LOGIN
    // ============================================================

    private async Task FazerLogin()
    {
        if (isLoading)
            return;

        mensagemErro = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            mensagemErro = "Digite seu e-mail.";
            return;
        }

        if (string.IsNullOrWhiteSpace(senha))
        {
            mensagemErro = "Digite sua senha.";
            return;
        }

        try
        {
            isLoading = true;

            // ====================================================
            // 1. AUTENTICAÇÃO PELO SUPABASE AUTH
            // ====================================================

            await Supabase.Auth.SignIn(
                email.Trim(),
                senha
            );

            // ====================================================
            // 2. GARANTE QUE O USUÁRIO FOI CARREGADO
            // ====================================================

            bool usuarioCarregado =
                await AuthStateProvider
                    .CarregarUsuarioAutenticadoAsync();

            // ====================================================
            // 3. CONFIRMA QUE O USUÁRIO FOI REALMENTE CARREGADO
            // ====================================================

            if (!usuarioCarregado)
            {
                mensagemErro =
                    "O login foi realizado, mas não foi possível carregar os dados do usuário.";

                return;
            }

            // ====================================================
            // 4. SÓ NAVEGA DEPOIS DE TUDO ESTAR PRONTO
            // ====================================================

            Nav.NavigateTo(
                Sessao.ExigeTrocaSenha ? "/alterar-senha" : "/",
                forceLoad: false
            );
        }
        catch
        {
            mensagemErro =
                "E-mail ou senha incorretos.";
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>

    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;

        min-height: 100vh;

        background-color: #f4f6f5;

        width: 100vw;

        position: absolute;

        top: 0;
        left: 0;

        z-index: 9999;
    }

    .login-card {
        background: white;

        padding: 40px;

        border-radius: 12px;

        width: 100%;

        max-width: 450px;

        border-top: 5px solid #5D7663;
    }

</style>
