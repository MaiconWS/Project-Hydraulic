@page "/liberados"
@using ManutencaoWeb.Models
@using ManutencaoWeb.Services
@inject SessaoService Sessao
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Itens para Montagem - ManutencaoWeb</PageTitle>

<div class="dashboard-wrapper">
    <!-- =========================================
         MENU LATERAL
         ========================================= -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-gear-wide"><span> Manutenção WEB</span></i>
        </div>
        
        <ul class="sidebar-menu">
            <li>
                <a href="/">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>

            <li>
                <a href="/requisicoes">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Requisições</span>
                </a>
            </li>
            <li>
                <a href="/relatorios">
                    <i class="bi bi-bar-chart"></i>
                    <span>Relatórios</span>
                </a>
            </li>
            <li class="active">
                <a href="/liberados">
                    <i class="bi bi-wrench-adjustable"></i> <span>Liberados</span>
                </a>
            </li>
            @if (Sessao.IsAdmin)
            {
                <li>
                    <a href="/admin">
                        <i class="bi bi-plus-square"></i>
                        <span>Cadastros Base</span>
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center gap-2 mb-3 px-2">
                <div class="user-avatar">@(Sessao.Iniciais)</div>
                <div style="font-size: 12px; color: #cfdcd4;">
                    <strong>@Sessao.NomeUsuario</strong><br />
                </div>
            </div>
            <button class="btn-sair" @onclick="Sair">
                <i class="bi bi-box-arrow-right"></i> <span>Sair</span>
            </button>
        </div>
    </nav>

    <!-- =========================================
         CONTEÚDO PRINCIPAL
         ========================================= -->
    <main class="main-content">
        <header class="top-bar">
            <div class="top-left d-flex align-items-center">
                <span class="user-greeting">Olá, <strong>@Sessao.NomeUsuario!</strong></span>
            </div>
            
            <div class="top-right">
                <div class="user-avatar">@(Sessao.Iniciais)</div>
            </div>
            
        </header>

        <div class="content-body" style="background-color: #f8f9fa; min-height: calc(100vh - 70px); padding: 30px;">
            <!-- TÍTULO -->
            <div class="d-flex align-items-start mb-4 gap-3">
                <button class="btn btn-light mb-3 border" @onclick="Voltar">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="bg-success text-white rounded p-3 me-3 d-flex align-items-center justify-content-center"
                     style="width: 48px; height: 48px;">
                    <i class="bi bi-wrench fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1" style="color: #1a1a1a;">Itens para Montagem</h3>
                    <p class="text-muted mb-0 small">Lista dos componentes que já tiveram todas as peças verificadas e
                        estão aguardando a montagem.</p>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-success"></div>
                    </div>
                }
                else
                {
                    <!-- =========================================
                     CARDS DE RESUMO
                     ========================================= -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center bg-white">
                                <i class="bi bi-box-seam text-success fs-3 me-3"></i>
                                <div>
                                    <small class="text-muted fw-semibold">Total de Itens</small>
                                    <h4 class="fw-bold mb-0">@totalItens</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center bg-white">
                                <i class="bi bi-check-circle text-success fs-3 me-3"></i>
                                <div>
                                    <small class="text-muted fw-semibold">Peças Verificadas</small>
                                    <h4 class="fw-bold mb-0">@pecasVerificadas</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center bg-white">
                                <i class="bi bi-wrench-adjustable text-success fs-3 me-3"></i>
                                <div>
                                    <small class="text-muted fw-semibold">Aguardando Montagem</small>
                                    <h4 class="fw-bold mb-0">@totalItens</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center bg-white">
                                <i class="bi bi-calendar3 text-success fs-3 me-3"></i>
                                <div>
                                    <small class="text-muted fw-semibold">Última Atualização</small>
                                    <h4 class="fw-bold mb-0 fs-6 mt-1">@DateTime.Now.ToString("dd/MM/yyyy")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =========================================
                     TABELA DE LIBERADOS COM FILTROS
                     ========================================= -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white py-3 border-bottom">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">Categoria</label>
                                    <select class="form-select" @bind="filtroCategoria">
                                        <option value="">Todas as categorias</option>
                                        @foreach (var categoria in categorias)
                                        {
                                            <option value="@categoria">@categoria</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <button class="btn btn-success px-4 fw-bold me-2" @onclick="AplicarFiltros">
                                        <i class="bi bi-search me-1"></i> Filtrar
                                    </button>
                                    <button class="btn btn-outline-secondary px-3" @onclick="LimparFiltros">
                                        <i class="bi bi-x-circle me-1"></i> Limpar
                                    </button>
                                </div>
                            </div>
                        </div>
                    
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 border-top-0">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th class="ps-4 fw-semibold border-0 py-3">O.S.</th>
                                        <th class="fw-semibold border-0 py-3">Componente / Modelo</th>
                                        <th class="fw-semibold border-0 py-3 text-center">Itens Qtd.</th>
                                        <th class="fw-semibold border-0 py-3">Data de Liberação</th>
                                        <th class="fw-semibold border-0 py-3">Status</th>
                                        <th class="fw-semibold border-0 py-3 text-end pe-4">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!listaLiberados.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">Nenhum componente aguardando
                                                montagem no momento.</td>
                                            </tr>
                                        }
                                else
                                        {
                                            @foreach (var os in listaLiberados)
                                            {
                                                var qtdItens = os.ItensJson?.Sum(i => i.Quantidade) ?? 0;
                                        
                                                <tr>
                                                    <td class="ps-4 text-dark fw-bold">@os.OsNumero</td>
                                                    <td class="text-dark">@os.ModeloSolicitado</td>
                                                    <td class="text-center fw-semibold text-secondary">@qtdItens</td>
                                                    <td class="text-secondary">@os.DataEnvio.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <span
                                                            class="badge rounded-pill bg-warning text-dark px-3 py-2 border border-warning"
                                                            style="background-color: #fff8dd !important; color: #d99a00 !important;">
                                                            <i class="bi bi-clock-history me-1"></i> Aguardando montagem
                                                        </span>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <button class="btn btn-success btn-sm px-3 py-2 fw-bold"
                                                                style="background-color: #2e664b; border: none; border-radius: 6px;"
                                                                @onclick="() => MarcarComoPronto(os)">
                                                            <i class="bi bi-check2-circle me-1"></i> Pronto / Concluído
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                    
                            @if (listaLiberados.Any())
                            {
                                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                                    <small class="text-muted">Mostrando 1 a @listaLiberados.Count de @listaLiberados.Count
                                        registros</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </main>
            </div>

@code {
    private bool isLoading = true;
    
    // Listas de dados
    private List<SolicitacaoCompletaModel> todasSolicitacoesLiberadas = new();
    private List<SolicitacaoCompletaModel> listaLiberados = new();
    
    // Dados de suporte para Categoria
    private List<SistemaModel> sistemas = new();
    private List<ComponenteModel> componentesCadastrados = new();
    private List<string> categorias = new();
    
    // Variável do filtro
    private string filtroCategoria = string.Empty;

    // Contadores para os Cards (Atualizados automaticamente ao filtrar)
    private int totalItens => listaLiberados.Count;
    private int pecasVerificadas => listaLiberados.Sum(s => s.ItensJson?.Sum(i => i.Quantidade) ?? 0);

    protected override async Task OnInitializedAsync()
    {
        if (!Sessao.EstaLogado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            isLoading = true;
            
            // 1. Carregar sistemas e componentes para obter as categorias vinculadas
            var resSistemas = await Supabase.From<SistemaModel>().Get();
            sistemas = resSistemas.Models ?? new List<SistemaModel>();

            categorias = sistemas
                .Where(s => !string.IsNullOrWhiteSpace(s.Categoria))
                .Select(s => s.Categoria!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c)
                .ToList();

            var resComponentes = await Supabase.From<ComponenteModel>().Get();
            componentesCadastrados = resComponentes.Models ?? new List<ComponenteModel>();

            // 2. Busca diretamente do Supabase todas as ordens com status "Liberado"
            var response = await Supabase
                .From<SolicitacaoCompletaModel>()
                .Filter("status", Postgrest.Constants.Operator.Equals, "Liberado")
                .Get();

            var dados = response.Models ?? new List<SolicitacaoCompletaModel>();

            // Salva os dados brutos
            todasSolicitacoesLiberadas = dados
                .OrderByDescending(s => s.DataEnvio)
                .ToList();
                
            // Aplica os filtros (se houver, senão traz tudo)
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao carregar dados: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // ============================================================
    // LÓGICA DE FILTRAGEM
    // ============================================================
    private void AplicarFiltros()
    {
        var query = todasSolicitacoesLiberadas.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroCategoria))
        {
            // Descobrir quais modelos de componentes pertencem à categoria selecionada
            var modelosDaCategoria = componentesCadastrados
                .Where(c =>
                    !string.IsNullOrWhiteSpace(c.Modelo) &&
                    string.Equals(CategoriaDoComponente(c), filtroCategoria, StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Modelo!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            // Filtrar apenas as solicitações onde o modelo consta na lista permitida
            query = query.Where(s =>
                !string.IsNullOrWhiteSpace(s.ModeloSolicitado) &&
                modelosDaCategoria.Contains(s.ModeloSolicitado));
        }

        listaLiberados = query.ToList();
    }

    private void LimparFiltros()
    {
        filtroCategoria = string.Empty;
        AplicarFiltros();
    }

    private string CategoriaDoComponente(ComponenteModel componente)
    {
        var sistema = sistemas.FirstOrDefault(s => s.Id == componente.SistemaId);
        return sistema?.Categoria ?? string.Empty;
    }

    // ============================================================
    // AÇÕES
    // ============================================================
    private async Task MarcarComoPronto(SolicitacaoCompletaModel solicitacao)
    {
        bool confirmacao = await JS.InvokeAsync<bool>("confirm", $"Deseja confirmar a conclusão da montagem da O.S. {solicitacao.OsNumero}?");
        if (!confirmacao) return;

        try
        {
            // Atualiza o status para "Montagem Concluída" enviando o modelo completo
            solicitacao.Status = "Montagem Concluída";

            await Supabase
                .From<SolicitacaoCompletaModel>()
                .Where(s => s.Id == solicitacao.Id)
                .Update(solicitacao);

            await JS.InvokeVoidAsync("alert", "Montagem concluída com sucesso!");
            
            // Recarrega a tela para remover o item da listagem
            await CarregarDados();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao atualizar status: {ex.Message}");
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private void Sair()
    {
        Sessao.Logout();
        Nav.NavigateTo("/login");
    }
}