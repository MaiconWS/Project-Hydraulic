@page "/relatorios"
@attribute [Authorize(Roles = "Aprovisionador,Admin")]

@using ManutencaoWeb.Models
@using ManutencaoWeb.Services
@using System.Globalization

@inject SessaoService Sessao
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Relatórios - ManutencaoWeb</PageTitle>



            <div id="areaRelatorioPdf" class="relatorios-export-area">

                <!-- =================================================
                     CABEÇALHO DO RELATÓRIO
                     ================================================= -->
                <div class="section-title mb-4">
                    <div class="d-flex align-items-start mb-4 gap-3">
                        <button class="btn btn-light mb-3 border" @onclick="Voltar">
                            <i class="bi bi-arrow-left"></i>
                        </button>
                        <h2>
                            Relatórios Gerenciais
                        </h2>
                    </div>
                    <p>
                        Acompanhe indicadores de atendimento, giro dos modelos e consumo de peças.
                    </p>

                </div>


                @if (isLoading)
                {
                    <div class="text-center py-5">

                        <div class="spinner-border text-success" role="status">
                        </div>

                        <p class="text-muted mt-3">
                            Carregando dados dos relatórios...
                        </p>

                    </div>
                }
                else
                {

                    <!-- =================================================
                         FILTROS
                         ================================================= -->
                    <div class="card border-0 shadow-sm p-4 mb-4">

                        <h5 class="mb-3 fw-bold text-secondary">

                            <i class="bi bi-funnel me-2"></i>

                            Filtros de Pesquisa

                        </h5>


                        <div class="row g-3">

                            <div class="col-md-3">

                                <label class="form-label small fw-bold">
                                    Data Inicial
                                </label>

                                <input type="date" class="form-control" @bind="filtroDataInicio" />

                            </div>


                            <div class="col-md-3">

                                <label class="form-label small fw-bold">
                                    Data Final
                                </label>

                                <input type="date" class="form-control" @bind="filtroDataFim" />

                            </div>


                            <div class="col-md-3">

                                <label class="form-label small fw-bold">
                                    Sistema
                                </label>

                                <select class="form-select" @bind="filtroSistema" @bind:after="AoAlterarSistema">

                                    <option value="">
                                        Todos os sistemas
                                    </option>

                                    @foreach (var sistema in sistemasDisponiveis)
                                    {
                                        <option value="@sistema">
                                            @sistema
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="col-md-3">

                                <label class="form-label small fw-bold">
                                    Modelo
                                </label>

                                <select class="form-select" @bind="filtroModelo" @bind:after="AplicarFiltros"
                                        disabled="@(string.IsNullOrWhiteSpace(filtroSistema) || !ModelosDisponiveis.Any())">

                                    <option value="">
                                        Todos os modelos
                                    </option>

                                    @foreach (var modelo in ModelosDisponiveis)
                                    {
                                        <option value="@modelo">
                                            @modelo
                                        </option>
                                    }

                                </select>

                                <small class="text-muted">
                                    Selecione primeiro o sistema para filtrar os modelos.
                                </small>

                            </div>


                            <div class="col-md-4">

                                <label class="form-label small fw-bold">
                                    Número da O.S.
                                </label>

                                <input type="text" class="form-control" @bind="filtroOs" placeholder="Ex: 1023" />

                            </div>


                            <div class="col-md-8 d-flex align-items-end gap-2">

                                <button class="btn btn-success px-4 fw-bold" @onclick="AplicarFiltros">

                                    <i class="bi bi-search me-1"></i>

                                    Filtrar

                                </button>


                                <button class="btn btn-outline-secondary px-3" @onclick="LimparFiltros">

                                    <i class="bi bi-x-circle me-1"></i>

                                    Limpar

                                </button>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         BOTÕES DE EXPORTAÇÃO
                         ================================================= -->
                    <div class="card border-0 shadow-sm p-3 mb-4">

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">

                            <div>

                                <h5 class="fw-bold mb-1">

                                    <i class="bi bi-download text-success me-2"></i>

                                    Exportar Relatório

                                </h5>

                                <small class="text-muted">

                                    As exportações em Excel respeitam os filtros
                                    atualmente aplicados.

                                </small>

                            </div>


                            <div class="relatorios-export-buttons">

                                <button class="btn btn-success" @onclick="ExportarRankingExcel"
                                        disabled="@(top10ItensPorComponente.Count == 0)">

                                    <i class="bi bi-file-earmark-excel me-2"></i>

                                    Ranking Excel

                                </button>


                                <button class="btn btn-success" @onclick="ExportarDetalhamentoExcel"
                                        disabled="@(listaFiltrada.Count == 0)">

                                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>

                                    O.S. Excel

                                </button>


                                <button class="btn btn-danger" @onclick="ExportarPdf">

                                    <i class="bi bi-file-earmark-pdf me-2"></i>

                                    Relatório PDF

                                </button>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         RESUMO
                         ================================================= -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-3">

                            <div class="card border-0 shadow-sm p-3 bg-light h-100">

                                <small class="text-muted">
                                    Total de Requisições
                                </small>

                                <h3 class="fw-bold mt-1 mb-0">
                                    @totalRequisicoes
                                </h3>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="card border-0 shadow-sm p-3 bg-light h-100">

                                <small class="text-muted">
                                    Requisições Pendentes
                                </small>

                                <h3 class="fw-bold mt-1 mb-0 text-warning">
                                    @requisicoesPendentes
                                </h3>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="card border-0 shadow-sm p-3 bg-light h-100">

                                <small class="text-muted">
                                    Requisições Concluídas
                                </small>

                                <h3 class="fw-bold mt-1 mb-0 text-success">
                                    @requisicoesConcluidas
                                </h3>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="card border-0 shadow-sm p-3 bg-light h-100">

                                <small class="text-muted">
                                    O.S. Liberadas
                                </small>

                                <h3 class="fw-bold mt-1 mb-0 text-success">
                                    @componentesLiberados
                                </h3>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         INDICADORES
                         ================================================= -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-4 h-100">

                                <h5 class="fw-bold mb-3">

                                    <i class="bi bi-speedometer2 text-success me-2"></i>

                                    Indicadores de Controle

                                </h5>


                                <div class="d-flex justify-content-between border-bottom py-2">

                                    <span class="text-muted">
                                        O.S. Pendentes:
                                    </span>

                                    <strong>
                                        @requisicoesPendentes ordens
                                    </strong>

                                </div>


                                <div class="d-flex justify-content-between border-bottom py-2">

                                    <span class="text-muted">
                                        O.S. Concluídas:
                                    </span>

                                    <strong class="text-success">
                                        @requisicoesConcluidas ordens
                                    </strong>

                                </div>


                                <div class="d-flex justify-content-between border-bottom py-2">

                                    <span class="text-muted">
                                        O.S. Liberadas:
                                    </span>

                                    <strong class="text-success">
                                        @componentesLiberados
                                    </strong>

                                </div>


                                <div class="d-flex justify-content-between border-bottom py-2">

                                    <span class="text-muted">
                                        O.S. Condenadas:
                                    </span>

                                    <strong class="text-danger">
                                        @componentesCondenados
                                    </strong>

                                </div>


                                <div class="d-flex justify-content-between py-2">

                                    <span class="text-muted">
                                        Percentual Médio de Atendimento:
                                    </span>

                                    <strong class="text-success">
                                        @percentualMedioAtendimento.ToString("F1")%
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-4 h-100">

                                        <h5 class="fw-bold mb-3">

                                    <i class="bi bi-bar-chart-line text-success me-2"></i>

                                    @(!string.IsNullOrWhiteSpace(filtroModelo) ? "Giro do modelo selecionado" : "Modelos com maior giro")

                                </h5>

                                @if (!modelosMaisGiro.Any())
                                {
                                    <p class="text-muted mb-0">Nenhuma solicitação encontrada para os filtros.</p>
                                }
                                else
                                {
                                    @foreach (var modeloGiro in modelosMaisGiro)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between gap-2 mb-1">
                                                <strong class="text-truncate">@modeloGiro.Modelo</strong>
                                                <small class="text-muted text-nowrap">@modeloGiro.TotalSolicitacoes O.S. · @modeloGiro.TotalUnidades unidades</small>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar bg-success" role="progressbar"
                                                     style="width: @(PercentualGiro(modeloGiro))%"></div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>

                        </div>

                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-3">
                                    <h5 class="fw-bold mb-1">
                                        <i class="bi bi-box-seam text-success me-2"></i>
                                        Peças mais utilizadas
                                    </h5>
                                    <small class="text-muted">
                                        @(!string.IsNullOrWhiteSpace(filtroModelo) ? $"Consumo do modelo {filtroModelo}." : "Consumo dos modelos incluídos nos filtros.")
                                        Ordenado por O.S. distintas; unidades desempata. A contagem considera os filtros selecionados.
                                    </small>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-4">SAP</th>
                                                <th>Peça</th>
                                                <th class="text-center">Unidades</th>
                                                <th class="text-center">O.S. distintas</th>
                                                <th>Modelo líder</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!pecasMaisUtilizadas.Any())
                                            {
                                                <tr><td colspan="5" class="text-center py-4 text-muted">Nenhum consumo encontrado para os filtros.</td></tr>
                                            }
                                            else
                                            {
                                                @foreach (var peca in pecasMaisUtilizadas)
                                                {
                                                    <tr>
                                                        <td class="ps-4"><code>@(string.IsNullOrWhiteSpace(peca.SapPeca) ? "-" : peca.SapPeca)</code></td>
                                                        <td>@peca.Descricao</td>
                                                        <td class="text-center fw-semibold">@peca.TotalUnidades</td>
                                                        <td class="text-center">@peca.OrdensDistintas</td>
                                                        <td>@(string.IsNullOrWhiteSpace(peca.ModeloLider) ? "-" : peca.ModeloLider)</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <h5 class="fw-bold mb-1">
                                    <i class="bi bi-bar-chart-line text-success me-2"></i>
                                    Consumo mensal por peça
                                </h5>
                                <small class="text-muted">@(consumoPorOrdensDistintas ? "O.S. distintas por mês" : "Unidades solicitadas por mês") · @TituloEscopoConsumo</small>
                            </div>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Métrica do gráfico de consumo">
                                <button type="button" class="btn @(consumoPorOrdensDistintas ? "btn-success" : "btn-outline-success")"
                                        aria-pressed="@consumoPorOrdensDistintas" @onclick="() => consumoPorOrdensDistintas = true">
                                    O.S. distintas
                                </button>
                                <button type="button" class="btn @(!consumoPorOrdensDistintas ? "btn-success" : "btn-outline-success")"
                                        aria-pressed="@(!consumoPorOrdensDistintas)" @onclick="() => consumoPorOrdensDistintas = false">
                                    Unidades
                                </button>
                            </div>
                            @if (seriesConsumoMensal.Any())
                            {
                                <div class="d-flex flex-wrap gap-3 small">
                                    @foreach (var serie in seriesConsumoMensal)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2">
                                            <span class="legenda-consumo @serie.ClasseCor"></span>
                                            @serie.Descricao
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            @if (!seriesConsumoMensal.Any())
                            {
                                <p class="text-muted text-center py-5 mb-0">Não há consumo de peças para exibir nesse período e modelo.</p>
                            }
                            else
                            {
                                <div class="consumo-grafico" role="img" aria-label="Consumo mensal por peça">
                                    @foreach (var mes in mesesConsumo)
                                    {
                                        <div class="consumo-mes">
                                            <div class="consumo-barras">
                                                @foreach (var serie in seriesConsumoMensal)
                                                {
                                                    var valorMes = ObterValorConsumoMes(serie, mes.Data);
                                                    var unidadeMetrica = consumoPorOrdensDistintas ? "O.S. distintas" : "unidades";
                                                    <div class="consumo-barra-coluna" title="@($"{serie.Descricao}: {valorMes} {unidadeMetrica} em {mes.Rotulo}")">
                                                        @if (valorMes > 0)
                                                        {
                                                            <small>@valorMes</small>
                                                        }
                                                        <div class="consumo-barra @serie.ClasseCor" style="height: @(AlturaBarraConsumo(valorMes))px"></div>
                                                    </div>
                                                }
                                            </div>
                                            <small class="consumo-rotulo-mes">@mes.Rotulo</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>


                    <!-- =================================================
                         RANKING
                         ================================================= -->
                    <div id="tabelaRanking" class="card border-0 shadow-sm mb-4">

                        <div class="card-header bg-white py-3">

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                                <div>

                                    <h5 class="fw-bold mb-1">

                                        <i class="bi bi-box-seam text-success me-2"></i>

                                        Peças Mais Requisitadas por Modelo

                                    </h5>

                                    <small class="text-muted">

                                        @top10ItensPorComponente.Select(item => item.Modelo).Distinct().Count() modelos ·
                                        @top10ItensPorComponente.Count peças no ranking

                                    </small>

                                </div>


                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => rankingExpandido = !rankingExpandido"
                                            aria-expanded="@rankingExpandido" aria-controls="conteudoRanking">
                                        <i class="bi @(rankingExpandido ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                        @(rankingExpandido ? "Recolher" : "Ver ranking")
                                    </button>
                                    <button class="btn btn-outline-success btn-sm" @onclick="ExportarRankingExcel"
                                            disabled="@(top10ItensPorComponente.Count == 0)">
                                        <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                    </button>
                                </div>

                            </div>

                        </div>


                        @if (rankingExpandido)
                        {
                        <div id="conteudoRanking" class="table-responsive">

                            <table class="table table-hover table-sm align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            Modelo
                                        </th>

                                        <th>
                                            Código SAP
                                        </th>

                                        <th>
                                            Descrição
                                        </th>

                                        <th class="text-center">
                                            Quantidade
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @if (!top10ItensPorComponente.Any())
                                    {
                                        <tr>

                                            <td colspan="4" class="text-center py-4 text-muted">

                                                Nenhum dado encontrado.

                                            </td>

                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in top10ItensPorComponente)
                                        {
                                            <tr>

                                                <td class="ps-4 fw-bold">
                                                    @item.Modelo
                                                </td>

                                                <td>
                                                    <code>
                                                        @item.SapPeca
                                                    </code>
                                                </td>

                                                <td>
                                                    @item.Descricao
                                                </td>

                                                <td class="text-center">

                                                    <span class="badge bg-success">

                                                        @item.TotalQuantidade un.

                                                    </span>

                                                </td>

                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>

                        </div>
                        }

                    </div>


                    <!-- =================================================
                         DETALHAMENTO
                         ================================================= -->
                    <div id="tabelaDetalhamento" class="card border-0 shadow-sm mb-5">

                        <div class="card-header bg-white py-3">

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        <i class="bi bi-table text-success me-2"></i>
                                        Detalhamento por O.S
                                    </h5>
                                    <small class="text-muted">@listaFiltrada.Count ordens nos filtros selecionados</small>
                                </div>


                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => detalhamentoExpandido = !detalhamentoExpandido"
                                            aria-expanded="@detalhamentoExpandido" aria-controls="conteudoDetalhamento">
                                        <i class="bi @(detalhamentoExpandido ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                        @(detalhamentoExpandido ? "Recolher" : "Ver ordens")
                                    </button>
                                    <button class="btn btn-outline-success btn-sm" @onclick="ExportarDetalhamentoExcel"
                                            disabled="@(listaFiltrada.Count == 0)">
                                        <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                    </button>
                                </div>

                            </div>

                        </div>


                        @if (detalhamentoExpandido)
                        {
                        <div id="conteudoDetalhamento" class="table-responsive">

                            <table class="table table-hover table-sm align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            O.S.
                                        </th>

                                        <th>
                                            Data
                                        </th>

                                        <th>
                                            Modelo
                                        </th>

                                        <th class="text-center">
                                            Itens
                                        </th>

                                        <th class="text-center">
                                            Entregues
                                        </th>

                                        <th class="text-center">
                                            Liberados
                                        </th>

                                        <th class="text-center">
                                            Condenados
                                        </th>

                                        <th class="text-center">
                                            Pendentes
                                        </th>

                                        <th class="text-center">
                                            %
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @if (!listaFiltrada.Any())
                                    {
                                        <tr>

                                            <td colspan="9" class="text-center py-4 text-muted">

                                                Nenhuma requisição encontrada
                                                para os filtros selecionados.

                                            </td>

                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in listaFiltrada)
                                        {
                                            var itensDaOs = itensPorSolicitacao.ContainsKey(item.Id)
                                                ? itensPorSolicitacao[item.Id]
                                                : new List<SolicitacaoItemModel>();

                                            // A coluna Itens mostra a quantidade física de peças.
                                            // Os demais indicadores abaixo contam O.S.: cada O.S. = 1.
                                            var totalItens = itensDaOs.Sum(i => i.Quantidade);

                                            var osLiberada =
                                                string.Equals(
                                                    item.Status?.Trim(),
                                                    "Liberado",
                                                    StringComparison.OrdinalIgnoreCase);

                                            var osCondenada =
                                                string.Equals(
                                                    item.Status?.Trim(),
                                                    "Condenado",
                                                    StringComparison.OrdinalIgnoreCase);

                                            var osEntregue = IsOsEntregue(item);

                                            var osPendente = IsOsPendente(item);

                                            var itensEntregues = osEntregue ? 1 : 0;
                                            var itensLiberados = osLiberada ? 1 : 0;
                                            var itensCondenados = osCondenada ? 1 : 0;
                                            var itensPendentes = osPendente ? 1 : 0;

                                            var percentual =
                                                osEntregue || osLiberada || osCondenada
                                                    ? 100
                                                    : 0;

                                            <tr>

                                                <td class="ps-4 fw-bold">
                                                    @item.OsNumero
                                                </td>

                                                <td>
                                                    @FormatarData(item.DataEnvio)
                                                </td>

                                                <td>
                                                    @item.ModeloSolicitado
                                                </td>

                                                <td class="text-center">
                                                    @totalItens
                                                </td>

                                                <td class="text-center text-success fw-bold">
                                                    @itensEntregues
                                                </td>

                                                <td class="text-center text-success fw-bold">
                                                    @itensLiberados
                                                </td>

                                                <td class="text-center text-danger fw-bold">
                                                    @itensCondenados
                                                </td>

                                                <td class="text-center text-warning fw-bold">
                                                    @itensPendentes
                                                </td>

                                                <td class="text-center">

                                                    <span
                                                        class="badge @(percentual >= 100 ? "bg-success" : percentual > 0 ? "bg-warning text-dark" : "bg-secondary")">

                                                        @percentual.ToString("F0")%

                                                    </span>

                                                </td>

                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>

                        </div>
                        }

                    </div>

                }

            </div>




<!-- =============================================================
     ESTILO LOCAL DA PÁGINA
     ============================================================= -->
<style>
    .relatorios-export-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .relatorios-export-buttons .btn {
        min-width: 150px;
        font-weight: 600;
    }

    .relatorios-export-area {
        width: 100%;
    }

    #areaRelatorioPdf {
        background: #f4f6f5;
    }

    .relatorios-export-area .card {
        break-inside: avoid;
    }

    .consumo-grafico {
        display: flex;
        align-items: stretch;
        gap: 8px;
        min-width: 680px;
        height: 250px;
        padding: 12px 8px 0;
        overflow-x: auto;
        background: repeating-linear-gradient(
            to top,
            transparent 0,
            transparent 48px,
            rgba(108, 117, 125, 0.12) 49px,
            transparent 50px);
