@code {

    // ============================================================
    // ESTADO
    // ============================================================

    private bool isLoading = true;

    private bool rankingExpandido;
    private bool detalhamentoExpandido;
    private bool consumoPorOrdensDistintas = true;


    // ============================================================
    // DADOS
    // ============================================================

    private List<SolicitacaoCompletaModel> todasSolicitacoes = new();

    private Dictionary<long, List<SolicitacaoItemModel>> itensPorSolicitacao = new();

    private List<SolicitacaoCompletaModel> listaFiltrada = new();

    private List<SistemaModel> sistemas = new();

    private List<ComponenteModel> componentesCadastrados = new();

    private List<string> sistemasDisponiveis = new();


    // ============================================================
    // FILTROS
    // ============================================================

    private DateTime? filtroDataInicio;

    private DateTime? filtroDataFim;

    private string filtroSistema = string.Empty;

    private string filtroModelo = string.Empty;

    private string filtroOs = string.Empty;


    // ============================================================
    // INDICADORES
    // ============================================================

    private int totalRequisicoes =>
        listaFiltrada.Count;


    // ============================================================
    // O.S. LIBERADAS
    // ============================================================

    private int requisicoesLiberadas =>
        listaFiltrada.Count(s =>
            string.Equals(
                s.Status?.Trim(),
                "Liberado",
                StringComparison.OrdinalIgnoreCase));


    // ============================================================
    // O.S. CONDENADAS
    // ============================================================

    private int requisicoesCondenadas =>
        listaFiltrada.Count(s =>
            string.Equals(
                s.Status?.Trim(),
                "Condenado",
                StringComparison.OrdinalIgnoreCase));


    // ============================================================
    // O.S. CONCLUÍDAS
    // ============================================================
    // Uma O.S. concluída é aquela em que todas as peças
    // foram entregues.
    //
    // Cada O.S. vale 1, independentemente da quantidade
    // de peças que ela possui.

    private int requisicoesConcluidas =>
    Math.Max(
        0,
        totalRequisicoes
        - requisicoesPendentes
        - requisicoesLiberadas
        - requisicoesCondenadas
    );


    // ============================================================
    // O.S. PENDENTES
    // ============================================================
    // Status Pendente + pelo menos uma peça ainda não entregue.

    private int requisicoesPendentes =>
        listaFiltrada.Count(IsOsPendente);


    // ============================================================
    // COMPONENTES LIBERADOS
    // ============================================================

    private int componentesLiberados =>
        requisicoesLiberadas;


    // ============================================================
    // COMPONENTES CONDENADOS
    // ============================================================

    private int componentesCondenados =>
        requisicoesCondenadas;


    // ============================================================
    // PERCENTUAL MÉDIO DE ATENDIMENTO
    // ============================================================

    private double percentualMedioAtendimento
    {
        get
        {
            if (totalRequisicoes == 0)
                return 0;

            int requisicoesAtendidas =
                requisicoesConcluidas
                + requisicoesLiberadas
                + requisicoesCondenadas;

            return
                (double)requisicoesAtendidas
                / totalRequisicoes
                * 100;
        }
    }


    // ============================================================
    // RANKING
    // ============================================================

    private List<ItemRankingModel> top10ItensPorComponente = new();

    private List<ModeloGiroModel> modelosMaisGiro = new();

    private List<PecaConsumoModel> pecasMaisUtilizadas = new();

    private List<MesConsumoModel> mesesConsumo = new();

    private List<SerieConsumoModel> seriesConsumoMensal = new();

    private IEnumerable<string> ModelosDisponiveis
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroSistema))
                return Enumerable.Empty<string>();

            return componentesCadastrados
                .Where(c =>
                    !string.IsNullOrWhiteSpace(c.Modelo) &&
                    string.Equals(
                        CategoriaDoComponente(c),
                        filtroSistema,
                        StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Modelo!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(modelo => modelo);
        }
    }

    private string TituloEscopoConsumo =>
        $"{(!string.IsNullOrWhiteSpace(filtroModelo) ? filtroModelo : string.IsNullOrWhiteSpace(filtroSistema) ? "todos os sistemas e modelos" : $"todos os modelos de {filtroSistema}")} · {PeriodoConsumo}";

    private string PeriodoConsumo
    {
        get
        {
            var fim = filtroDataFim?.Date ?? DateTime.Today;
            var inicio = filtroDataInicio?.Date ?? fim.AddMonths(-5);
            return $"{inicio:MM/yyyy} a {fim:MM/yyyy}";
        }
    }

    private int MaiorGiro =>
        modelosMaisGiro
            .Select(modelo => modelo.TotalSolicitacoes)
            .DefaultIfEmpty(0)
            .Max();


    // ============================================================
    // INICIALIZAÇÃO
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        if (!Sessao.EstaLogado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await CarregarDados();
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }


    // ============================================================
    // CARREGAR DADOS
    // ============================================================

    private async Task CarregarDados()
    {
        try
        {
            isLoading = true;

            // ----------------------------------------------------
            // REQUISIÇÕES
            // ----------------------------------------------------

            var response =
                await Supabase
                    .From<SolicitacaoCompletaModel>()
                    .Get();

            todasSolicitacoes =
                response.Models
                ?? new List<SolicitacaoCompletaModel>();


            // ----------------------------------------------------
            // ITENS
            // ----------------------------------------------------

            var responseItens =
                await Supabase
                    .From<SolicitacaoItemModel>()
                    .Get();

            var todosOsItensBd =
                responseItens.Models
                ?? new List<SolicitacaoItemModel>();


            // ----------------------------------------------------
            // AGRUPAR ITENS POR O.S.
            // ----------------------------------------------------

            itensPorSolicitacao =
                todosOsItensBd
                    .GroupBy(i => i.SolicitacaoId)
                    .ToDictionary(
                        g => g.Key,
                        g => g.ToList());


            listaFiltrada =
                new List<SolicitacaoCompletaModel>(
                    todasSolicitacoes);


            // ----------------------------------------------------
            // SISTEMAS / CATEGORIAS
            // ----------------------------------------------------

            var resSistemas =
                await Supabase
                    .From<SistemaModel>()
                    .Get();

            sistemas =
                resSistemas.Models
                ?? new List<SistemaModel>();


            sistemasDisponiveis =
                sistemas
                    .Where(s =>
                        !string.IsNullOrWhiteSpace(
                            s.Categoria))
                    .Select(s => s.Categoria!)
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .OrderBy(c => c)
                    .ToList();


            // ----------------------------------------------------
            // COMPONENTES / MODELOS
            // ----------------------------------------------------

            var resComponentes =
                await Supabase
                    .From<ComponenteModel>()
                    .Get();

            componentesCadastrados =
                resComponentes.Models
                ?? new List<ComponenteModel>();


            CalcularIndicadores();
        }

        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao carregar dados do relatório:\n{ex.Message}");
        }

        finally
        {
            isLoading = false;
        }
    }


    // ============================================================
    // FILTROS
    // ============================================================

    private void AplicarFiltros()
    {
        listaFiltrada =
            FiltrarSolicitacoes(aplicarModelo: true)
                .OrderByDescending(s => s.DataEnvio)
                .ToList();


        CalcularIndicadores();
    }


    // ============================================================
    // LIMPAR FILTROS
    // ============================================================

    private void LimparFiltros()
    {
        filtroDataInicio = null;

        filtroDataFim = null;

        filtroSistema = string.Empty;

        filtroModelo = string.Empty;

        filtroOs = string.Empty;


        listaFiltrada =
            new List<SolicitacaoCompletaModel>(
                todasSolicitacoes);


        CalcularIndicadores();
    }

    private void AoAlterarSistema()
    {
        filtroModelo = string.Empty;
        AplicarFiltros();
    }

    private IEnumerable<SolicitacaoCompletaModel> FiltrarSolicitacoes(bool aplicarModelo)
    {
        IEnumerable<SolicitacaoCompletaModel> query = todasSolicitacoes;

        if (!string.IsNullOrWhiteSpace(filtroOs))
        {
            query = query.Where(s =>
                !string.IsNullOrWhiteSpace(s.OsNumero) &&
                s.OsNumero.Contains(filtroOs.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroSistema))
        {
            var modelosDoSistema = componentesCadastrados
                .Where(c =>
                    !string.IsNullOrWhiteSpace(c.Modelo) &&
                    string.Equals(
                        CategoriaDoComponente(c),
                        filtroSistema,
                        StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Modelo!.Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            query = query.Where(s =>
                !string.IsNullOrWhiteSpace(s.ModeloSolicitado) &&
                modelosDoSistema.Contains(s.ModeloSolicitado.Trim()));
        }

        if (aplicarModelo && !string.IsNullOrWhiteSpace(filtroModelo))
        {
            query = query.Where(s =>
                string.Equals(
                    s.ModeloSolicitado?.Trim(),
                    filtroModelo,
                    StringComparison.OrdinalIgnoreCase));
        }

        if (filtroDataInicio.HasValue)
        {
            var dataInicio = filtroDataInicio.Value.Date;
            query = query.Where(s => ObterDataLocal(s.DataEnvio).Date >= dataInicio);
        }

        if (filtroDataFim.HasValue)
        {
            var dataFim = filtroDataFim.Value.Date;
            query = query.Where(s => ObterDataLocal(s.DataEnvio).Date <= dataFim);
        }

        return query;
    }


    // ============================================================
    // CALCULAR INDICADORES
    // ============================================================

    private void CalcularIndicadores()
    {
        if (!listaFiltrada.Any())
        {
            top10ItensPorComponente.Clear();
            CalcularAnalisesGerenciais();

            return;
        }

        // --------------------------------------------------------
        // RANKING
        // --------------------------------------------------------

        var ranking =
            new List<ItemRankingModel>();


        foreach (var requisicao in listaFiltrada)
        {
            if (string.IsNullOrWhiteSpace(
                requisicao.ModeloSolicitado))
            {
                continue;
            }


            var itens =
                itensPorSolicitacao.ContainsKey(
                    requisicao.Id)
                    ? itensPorSolicitacao[requisicao.Id]
                    : new List<SolicitacaoItemModel>();


            if (!itens.Any())
                continue;


            foreach (var item in itens)
            {
                ranking.Add(
                    new ItemRankingModel
                    {
                        Modelo =
                            requisicao.ModeloSolicitado,

                        SapPeca =
                            item.SapPeca,

                        Descricao =
                            item.Descricao,

                        TotalQuantidade =
                            item.Quantidade
                    });
            }
        }


        // --------------------------------------------------------
        // AGRUPAR PEÇA POR MODELO
        // --------------------------------------------------------

        var rankingAgrupado =
            ranking
                .GroupBy(x => new
                {
                    Modelo = x.Modelo,
                    SapPeca = x.SapPeca,
                    Descricao = x.Descricao
                })
                .Select(g =>
                    new ItemRankingModel
                    {
                        Modelo =
                            g.Key.Modelo,

                        SapPeca =
                            g.Key.SapPeca,

                        Descricao =
                            g.Key.Descricao,

                        TotalQuantidade =
                            g.Sum(x =>
                                x.TotalQuantidade)
                    })
                .ToList();


        // --------------------------------------------------------
        // TOP 10 DE CADA MODELO
        // --------------------------------------------------------

        top10ItensPorComponente =
            rankingAgrupado
                .GroupBy(x => x.Modelo)
                .SelectMany(g =>
                    g.OrderByDescending(
                        x => x.TotalQuantidade)
                     .Take(10))
                .OrderBy(x => x.Modelo)
                .ThenByDescending(
                    x => x.TotalQuantidade)
                .ToList();

        CalcularAnalisesGerenciais();
    }

    private void CalcularAnalisesGerenciais()
    {
        // Mantém o ranking no mesmo escopo dos cartões e dos demais indicadores.
        var requisicoesParaGiro = FiltrarSolicitacoes(aplicarModelo: true).ToList();

        // O.S. conta todas as solicitações do modelo, inclusive as que ainda
        // não possuem linhas em solicitacao_itens. Unidades contam apenas itens gravados.
        modelosMaisGiro = requisicoesParaGiro
            .GroupBy(solicitacao =>
                string.IsNullOrWhiteSpace(solicitacao.ModeloSolicitado)
                    ? "Modelo não informado"
                    : solicitacao.ModeloSolicitado.Trim(),
                StringComparer.OrdinalIgnoreCase)
            .Select(grupo => new ModeloGiroModel
            {
                Modelo = grupo.Key,
                TotalSolicitacoes = grupo.Select(solicitacao => solicitacao.Id).Distinct().Count(),
                TotalUnidades = grupo.Sum(solicitacao =>
                    itensPorSolicitacao.TryGetValue(solicitacao.Id, out var itens)
                        ? itens.Sum(item => item.Quantidade)
                        : 0)
            })
            .OrderByDescending(modelo => modelo.TotalSolicitacoes)
            .ThenByDescending(modelo => modelo.TotalUnidades)
            .Take(5)
            .ToList();

        var linhasFiltradas = ObterLinhasComItens(listaFiltrada);

        pecasMaisUtilizadas = linhasFiltradas
            .Where(linha =>
                !string.IsNullOrWhiteSpace(linha.Item.SapPeca) ||
                !string.IsNullOrWhiteSpace(linha.Item.Descricao))
            .GroupBy(linha => new
            {
                Sap = linha.Item.SapPeca?.Trim() ?? string.Empty,
                Descricao = linha.Item.Descricao?.Trim() ?? string.Empty
            })
            .Select(grupo => new PecaConsumoModel
            {
                SapPeca = grupo.Key.Sap,
                Descricao = string.IsNullOrWhiteSpace(grupo.Key.Descricao) ? "Descrição não informada" : grupo.Key.Descricao,
                TotalUnidades = grupo.Sum(linha => linha.Item.Quantidade),
                OrdensDistintas = grupo.Select(linha => linha.Solicitacao.Id).Distinct().Count(),
                ModeloLider = grupo
                    .Where(linha => !string.IsNullOrWhiteSpace(linha.Solicitacao.ModeloSolicitado))
                    .GroupBy(linha => linha.Solicitacao.ModeloSolicitado!.Trim(), StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(modelo => modelo.Sum(linha => linha.Item.Quantidade))
                    .Select(modelo => modelo.Key)
                    .FirstOrDefault()
            })
            .OrderByDescending(peca => peca.OrdensDistintas)
            .ThenByDescending(peca => peca.TotalUnidades)
            .Take(10)
            .ToList();

        CalcularConsumoMensal(linhasFiltradas);
    }

    private List<(SolicitacaoCompletaModel Solicitacao, SolicitacaoItemModel Item)> ObterLinhasComItens(
        IEnumerable<SolicitacaoCompletaModel> requisicoes)
    {
        var linhas = new List<(SolicitacaoCompletaModel Solicitacao, SolicitacaoItemModel Item)>();

        foreach (var solicitacao in requisicoes)
        {
            if (!itensPorSolicitacao.TryGetValue(solicitacao.Id, out var itens))
                continue;

            linhas.AddRange(itens.Select(item => (solicitacao, item)));
        }

        return linhas;
    }

    private void CalcularConsumoMensal(
        List<(SolicitacaoCompletaModel Solicitacao, SolicitacaoItemModel Item)> linhas)
    {
        var fimReferencia = filtroDataFim?.Date ?? DateTime.Today;
        var inicioReferencia = filtroDataInicio?.Date ?? fimReferencia.AddMonths(-5);

        if (inicioReferencia > fimReferencia)
        {
            mesesConsumo.Clear();
            seriesConsumoMensal.Clear();
            return;
        }

        var primeiroMes = new DateTime(inicioReferencia.Year, inicioReferencia.Month, 1);
        var ultimoMes = new DateTime(fimReferencia.Year, fimReferencia.Month, 1);
        var quantidadeMeses = ((ultimoMes.Year - primeiroMes.Year) * 12) + ultimoMes.Month - primeiroMes.Month + 1;

        mesesConsumo = Enumerable.Range(0, quantidadeMeses)
            .Select(indice => primeiroMes.AddMonths(indice))
            .TakeWhile(mes => mes <= ultimoMes)
            .Select(mes => new MesConsumoModel
            {
                Data = mes,
                Rotulo = mes.ToString("MMM/yy", CultureInfo.GetCultureInfo("pt-BR"))
            })
            .ToList();

        if (mesesConsumo.Count == 0)
        {
            seriesConsumoMensal.Clear();
            return;
        }

        var inicioGrafico = mesesConsumo[0].Data;
        var fimGrafico = mesesConsumo[^1].Data.AddMonths(1);
        var linhasNoGrafico = linhas
            .Where(linha =>
            {
                var data = ObterDataLocal(linha.Solicitacao.DataEnvio);
                return data >= inicioGrafico && data < fimGrafico;
            })
            .ToList();

        var pecasDoGrafico = linhasNoGrafico
            .Where(linha =>
                !string.IsNullOrWhiteSpace(linha.Item.SapPeca) ||
                !string.IsNullOrWhiteSpace(linha.Item.Descricao))
            .GroupBy(linha => new
            {
                Sap = linha.Item.SapPeca?.Trim() ?? string.Empty,
                Descricao = linha.Item.Descricao?.Trim() ?? string.Empty
            })
            .OrderByDescending(grupo => grupo.Select(linha => linha.Solicitacao.Id).Distinct().Count())
            .ThenByDescending(grupo => grupo.Sum(linha => linha.Item.Quantidade))
            .Take(3)
            .ToList();

        var cores = new[] { "consumo-verde", "consumo-azul", "consumo-ambar" };

        seriesConsumoMensal = pecasDoGrafico
            .Select((grupo, indice) => new SerieConsumoModel
            {
                Descricao = string.IsNullOrWhiteSpace(grupo.Key.Descricao)
                    ? grupo.Key.Sap
                    : grupo.Key.Descricao,
                ClasseCor = cores[indice],
                UnidadesPorMes = mesesConsumo.ToDictionary(
                    mes => mes.Data,
                    mes => grupo
                        .Where(linha =>
                        {
                            var data = ObterDataLocal(linha.Solicitacao.DataEnvio);
                            return data.Year == mes.Data.Year && data.Month == mes.Data.Month;
                        })
                        .Sum(linha => linha.Item.Quantidade)),
                OrdensDistintasPorMes = mesesConsumo.ToDictionary(
                    mes => mes.Data,
                    mes => grupo
                        .Where(linha =>
                        {
                            var data = ObterDataLocal(linha.Solicitacao.DataEnvio);
                            return data.Year == mes.Data.Year && data.Month == mes.Data.Month;
                        })
                        .Select(linha => linha.Solicitacao.Id)
                        .Distinct()
                        .Count())
            })
            .ToList();
    }

    private int ObterValorConsumoMes(SerieConsumoModel serie, DateTime mes) =>
        consumoPorOrdensDistintas
            ? serie.OrdensDistintasPorMes.GetValueOrDefault(mes)
            : serie.UnidadesPorMes.GetValueOrDefault(mes);

    private int PercentualGiro(ModeloGiroModel modelo) =>
        MaiorGiro == 0
            ? 0
            : (int)Math.Round((double)modelo.TotalSolicitacoes / MaiorGiro * 100);

    private int AlturaBarraConsumo(int quantidade)
    {
        var maiorQuantidade = seriesConsumoMensal
            .SelectMany(serie => consumoPorOrdensDistintas
                ? serie.OrdensDistintasPorMes.Values
                : serie.UnidadesPorMes.Values)
            .DefaultIfEmpty(0)
            .Max();

        return maiorQuantidade == 0 || quantidade == 0
            ? 0
            : Math.Max(3, (int)Math.Round((double)quantidade / maiorQuantidade * 170));
    }


    // ============================================================
    // VERIFICAR SE O.S. FOI CONCLUÍDA
    // ============================================================

    private bool SolicitacaoConcluida(
        SolicitacaoCompletaModel solicitacao)
    {
        return
            IsOsEntregue(solicitacao)
            ||
            string.Equals(
                solicitacao.Status?.Trim(),
                "Liberado",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                solicitacao.Status?.Trim(),
                "Condenado",
                StringComparison.OrdinalIgnoreCase);
    }


    // ============================================================
    // VERIFICAR O.S. ENTREGUE
    // ============================================================

    // O.S. entregue:
    // status Pendente e todas as peças da O.S. entregues.
    //
    // A O.S. é contabilizada somente uma vez.

    private bool IsOsEntregue(SolicitacaoCompletaModel solicitacao)
    {
        if (!itensPorSolicitacao.TryGetValue(
                solicitacao.Id,
                out var itens))
        {
            return false;
        }

        if (itens == null || itens.Count == 0)
            return false;

        return itens.All(i => i.Entregue == true);
    }


    // ============================================================
    // VERIFICAR O.S. PENDENTE
    // ============================================================

    // O.S. pendente:
    // status Pendente e ainda existe pelo menos uma peça não entregue.
    //
    // Independentemente de ter 1 ou 20 peças,
    // a contagem é sempre 1 O.S.

    private bool IsOsPendente(
        SolicitacaoCompletaModel solicitacao)
    {
        var status =
            solicitacao.Status?.Trim()
            ?? "Pendente";


        if (!string.Equals(
            status,
            "Pendente",
            StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }


        return !IsOsEntregue(solicitacao);
    }


    // ============================================================
    // ENCONTRAR CATEGORIA DO COMPONENTE
    // ============================================================

    private string CategoriaDoComponente(
        ComponenteModel componente)
    {
        var sistema =
            sistemas.FirstOrDefault(
                s => s.Id == componente.SistemaId);


        return
            sistema?.Categoria
            ?? string.Empty;
    }


    // ============================================================
    // DATA
    // ============================================================

    private DateTime ObterDataLocal(
        DateTime data)
    {
        if (data.Kind == DateTimeKind.Utc)
            return data.ToLocalTime();

        return data;
    }


    private string FormatarData(
        DateTime data)
    {
        return
            ObterDataLocal(data)
                .ToString("dd/MM/yyyy HH:mm");
    }


    // ============================================================
    // EXPORTAR RANKING PARA EXCEL
    // ============================================================

    private async Task ExportarRankingExcel()
    {
        if (!top10ItensPorComponente.Any())
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Não existem dados para exportar.");

            return;
        }


        var dados =
            top10ItensPorComponente
                .Select(x => new
                {
                    Modelo =
                        x.Modelo ?? "",

                    CodigoSAP =
                        x.SapPeca ?? "",

                    Descricao =
                        x.Descricao ?? "",

                    Quantidade =
                        x.TotalQuantidade
                })
                .ToList();


        await JS.InvokeVoidAsync(
            "exportarRankingExcel",
            dados);
    }


    // ============================================================
    // EXPORTAR DETALHAMENTO PARA EXCEL
    // ============================================================

    private async Task ExportarDetalhamentoExcel()
    {
        if (!listaFiltrada.Any())
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Não existem dados para exportar.");

            return;
        }


        var dados =
            listaFiltrada
                .Select(item =>
                {
                    var itensDaOs =
                        itensPorSolicitacao.ContainsKey(
                            item.Id)
                            ? itensPorSolicitacao[item.Id]
                            : new List<SolicitacaoItemModel>();


                    var status =
                        item.Status?.Trim()
                        ?? "Pendente";


                    var totalItens =
                        itensDaOs.Sum(i => i.Quantidade);


                    // Cada O.S. vale 1 nos indicadores de situação.

                    var osLiberada =
                        string.Equals(
                            status,
                            "Liberado",
                            StringComparison.OrdinalIgnoreCase);


                    var osCondenada =
                        string.Equals(
                            status,
                            "Condenado",
                            StringComparison.OrdinalIgnoreCase);


                    var osEntregue =
                        IsOsEntregue(item);


                    var osPendente =
                        IsOsPendente(item);


                    return new
                    {
                        OS =
                            item.OsNumero ?? "",

                        Data =
                            FormatarData(
                                item.DataEnvio),

                        Modelo =
                            item.ModeloSolicitado ?? "",

                        Status =
                            status,

                        // Quantidade física de peças
                        // permanece apenas como informação.

                        Itens =
                            totalItens,

                        // Indicadores: cada O.S. = 1

                        Entregues =
                            osEntregue ? 1 : 0,

                        Liberados =
                            osLiberada ? 1 : 0,

                        Condenados =
                            osCondenada ? 1 : 0,

                        Pendentes =
                            osPendente ? 1 : 0,

                        Percentual =
                            (
                                osEntregue
                                ||
                                osLiberada
                                ||
                                osCondenada
                            )
                            ? 100
                            : 0
                    };
                })
                .ToList();


        await JS.InvokeVoidAsync(
            "exportarDetalhamentoExcel",
            dados);
    }


