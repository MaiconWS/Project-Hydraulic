@page "/checklist/{SapComp}/{NomeModelo}"
@using ManutencaoWeb.Models
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app-header">
    <h3>CheckList - @NomeModelo</h3>
</div>

<div class="container mt-4">
    <div class="mb-3">
        <label>Digite a O.S</label>
        <input class="form-control border-dark" @bind="osNumero" placeholder="Número da Ordem de Serviço" />
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle table-sm">
            <thead class="bg-custom text-white text-center">
                <tr>
                    <th>SAP</th>
                    <th>Descrição</th>
                    <th>Valor (R$)</th>
                    <th>Qtd</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr><td colspan="4" class="text-center">Carregando peças...</td></tr>
                }
                else if (pecas != null && pecas.Any())
                {
                    @foreach (var peca in pecas)
                    {
                        <tr>
                            <td class="text-center" style="font-size: 12px;">@peca.SapPeca</td>
                            <td style="font-size: 12px;">@peca.Descricao</td>
                            <td class="text-center" style="font-size: 12px;">@peca.Valor.ToString("F2")</td>
                            <td class="text-center" style="min-width: 100px;">
                                <button class="btn btn-sm btn-light p-1" @onclick="() => Diminuir(peca.SapPeca!)">-</button>
                                <span class="mx-2 fw-bold">@(quantidades.ContainsKey(peca.SapPeca!) ? quantidades[peca.SapPeca!] : 0)</span>
                                <button class="btn btn-sm btn-light p-1" @onclick="() => Aumentar(peca.SapPeca!)">+</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center">Nenhuma peça encontrada.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="text-center mt-4 mb-5">
        <button class="btn btn-enviar" @onclick="EnviarDados" disabled="@isEnviando">
            @(isEnviando ? "Enviando..." : "Enviar")
        </button>
    </div>
</div>

@code {
    [Parameter] public string ?SapComp { get; set; }
    [Parameter] public string ?NomeModelo { get; set; }

    private string ?osNumero = "";
    private List<PecaModel> pecas = new();
    private Dictionary<string, int> quantidades = new();
    
    private bool isLoading = true;
    private bool isEnviando = false;

    protected override async Task OnInitializedAsync()
    {
        var response = await Supabase.From<PecaModel>()
            .Filter("sap_comp", Postgrest.Constants.Operator.Equals, SapComp)
            .Get();

        pecas = response.Models;
        foreach (var p in pecas) quantidades[p.SapPeca!] = 0; // Inicia tudo com 0
        isLoading = false;
    }

    private void Aumentar(string sap) => quantidades[sap]++;
    
    private void Diminuir(string sap)
    {
        if (quantidades[sap] > 0) quantidades[sap]--;
    }

    private async Task EnviarDados()
    {
        // Mapeia somente as peças que o mecânico aumentou a quantidade (> 0)
        var itensParaEnviar = pecas
            .Where(p => quantidades.ContainsKey(p.SapPeca!) && quantidades[p.SapPeca!] > 0)
            .Select(p => new ItemJson
            {
                Sap = p.SapPeca!,
                Descricao = p.Descricao!,
                Quantidade = quantidades[p.SapPeca!],
                Valor = p.Valor
            }).ToList();

        if (string.IsNullOrWhiteSpace(osNumero) || !itensParaEnviar.Any())
        {
            await JS.InvokeVoidAsync("alert", "Por favor, preencha a O.S e adicione ao menos uma quantidade.");
            return;
        }

        isEnviando = true;

    try
    {
        var solicitacao = new SolicitacaoModel
        {
            OsNumero = osNumero.Trim(),
            ModeloSolicitado = NomeModelo,
            ItensJson = itensParaEnviar, // O C# vai serializar esta lista corretamente para o JSONB
            DataEnvio = DateTime.UtcNow
        };

        await Supabase.From<SolicitacaoModel>().Insert(solicitacao);
        
        await JS.InvokeVoidAsync("alert", "Solicitação enviada com sucesso!");
        Nav.NavigateTo("/"); 
    }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao enviar: {ex.Message}");
        }
        finally
        {
            isEnviando = false;
        }
    }
}