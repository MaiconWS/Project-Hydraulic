@page "/checklist/{SapComp}/{NomeModelo}"
@using ManutencaoWeb.Models
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ManutencaoWeb.Services
@inject SessaoService Sessao

<PageTitle>Checklist - @NomeModelo</PageTitle>

<div class="dashboard-wrapper">

    <!-- MENU LATERAL ESQUERDO -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-gear-wide"><span> Manutenção WEB</span></i>
        </div>

        <ul class="sidebar-menu">
            <li>
                <a href="/">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>

            <li class="active">
                <a href="/requisicoes">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Requisições</span>
                </a>
            </li>

            <li>
                <a href="/relatorios">
                    <i class="bi bi-bar-chart"></i>
                    <span>Relatórios</span>
                </a>
            </li>

            <li>
                <a href="/liberados">
                    <i class="bi bi-wrench-adjustable"></i>
                    <span>Liberados</span>
                </a>
            </li>

            @if (Sessao.IsAdmin)
            {
                <li>
                    <a href="/admin">
                        <i class="bi bi-plus-square"></i>
                        <span>Cadastros Base</span>
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            <button class="btn-sair" @onclick="Sair">
                <i class="oi oi-account-logout"></i> Sair
            </button>
        </div>
    </nav>


    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main-content">

        <div class="content-body">

            <!-- BOTÃO VOLTAR -->
            <button class="btn btn-light mb-3 border" @onclick="Voltar">
                <i class="bi bi-arrow-left"></i>
            </button>


            <!-- TÍTULO -->
            <div class="section-title mb-4">
                <h2>Checklist</h2>
                <p>@NomeModelo</p>
            </div>


            <!-- CAMPO DE ORDEM DE SERVIÇO -->
            <div class="card border-0 shadow-sm p-4 mb-4">
                <label class="fw-bold mb-2">
                    Informe a Ordem de Serviço
                </label>

                <input class="form-control"
                       @bind="osNumero"
                       placeholder="Digite o número da Ordem de Serviço" />
            </div>


            <!-- INFORMAÇÕES DO MODELO -->
            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-3 bg-light">

                        <small class="text-muted">
                            Modelo
                        </small>

                        <h6 class="mb-0 fw-bold">
                            @NomeModelo
                        </h6>

                    </div>
                </div>


                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-3 bg-light">

                        <small class="text-muted">
                            Total de itens
                        </small>

                        <h6 class="mb-0 fw-bold">
                            @pecas.Count componentes
                        </h6>

                    </div>
                </div>

            </div>


            <!-- TABELA DE PEÇAS -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="bg-success text-white">

                            <tr>
                                <th class="ps-4">SAP</th>
                                <th>Componente</th>
                                @*
                                <td>
                                    R$ @peca.Valor.ToString("F2")
                                </td>
                                *@

                                <th class="text-center pe-4">
                                    Quantidade
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @if (isLoading)
                            {
                                <tr>

                                    <td colspan="4"
                                        class="text-center py-4">

                                        Carregando peças...

                                    </td>

                                </tr>
                            }
                            else if (pecas != null && pecas.Any())
                            {
                                @foreach (var peca in pecas)
                                {
                                    <tr>

                                        <td class="ps-4 fw-bold text-secondary">
                                            @peca.SapPeca
                                        </td>


                                        <td>
                                            @peca.Descricao
                                        </td>

                                        @*
                                        <td>
                                            R$ @peca.Valor.ToString("F2")
                                        </td>
                                        *@

                                        <td class="text-center pe-4">

                                            <div class="d-inline-flex align-items-center border rounded bg-light px-2 py-1">

                                                <button class="btn btn-sm btn-link text-dark text-decoration-none p-0 px-2"
                                                        @onclick="() => Diminuir(peca.SapPeca!)">

                                                    -

                                                </button>


                                                <span class="mx-3 fw-bold">

                                                    @(quantidades.ContainsKey(peca.SapPeca!)
                                                        ? quantidades[peca.SapPeca!]
                                                        : 0)

                                                </span>


                                                <button class="btn btn-sm btn-link text-dark text-decoration-none p-0 px-2"
                                                        @onclick="() => Aumentar(peca.SapPeca!)">

                                                    +

                                                </button>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="4"
                                        class="text-center py-4">

                                        Nenhuma peça encontrada.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- RODAPÉ -->
            <div class="card border-0 shadow-sm p-4 bg-white d-flex flex-row align-items-center justify-content-between mb-5">

                <div>

                    <small class="text-muted d-block">
                        Resumo da seleção
                    </small>

                    <strong>
                        @TotalItensSelecionados itens selecionados
                    </strong>

                </div>
                @*
                <div>

                    <small class="text-muted d-block">
                        Total estimado
                    </small>

                    <h4 class="text-success fw-bold mb-0">
                        R$ @ValorTotalEstimado.ToString("F2")
                    </h4>

                </div>
                *@
                <button class="btn btn-success px-4 py-2 fw-bold"
                        @onclick="EnviarDados"
                        disabled="@isEnviando">

                    @(isEnviando
                        ? "Enviando..."
                        : "Enviar requisição")

                </button>

            </div>

        </div>

    </main>

</div>


@code {

    [Parameter]
    public string? SapComp { get; set; }


    [Parameter]
    public string? NomeModelo { get; set; }


    private string? osNumero = "";


    private List<PecaModel> pecas = new();


    private Dictionary<string, int> quantidades = new();


    private bool isLoading = true;


    private bool isEnviando = false;


    private int TotalItensSelecionados =>
        quantidades.Values.Sum();


// ============================================================
// VALOR TOTAL ESTIMADO
// DESATIVADO TEMPORARIAMENTE
//
// Mantido no código para possível utilização futura.
//
// private double ValorTotalEstimado =>
//     pecas.Sum(p =>
//         (quantidades.ContainsKey(p.SapPeca!)
//             ? quantidades[p.SapPeca!]
//             : 0)
//         * p.Valor);
//
// ============================================================


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Supabase
                .From<PecaModel>()
                .Filter(
                    "sap_comp",
                    Postgrest.Constants.Operator.Equals,
                    SapComp)
                .Get();


            pecas = response.Models;


            foreach (var p in pecas)
            {
                if (!string.IsNullOrEmpty(p.SapPeca))
                {
                    quantidades[p.SapPeca] = 0;
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao carregar peças: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    private void Aumentar(string sap)
    {
        if (quantidades.ContainsKey(sap))
        {
            quantidades[sap]++;
        }
    }


    private void Diminuir(string sap)
    {
        if (quantidades.ContainsKey(sap) &&
            quantidades[sap] > 0)
        {
            quantidades[sap]--;
        }
    }


    private void Voltar()
    {
        Nav.NavigateTo(
            $"/modelos/{Uri.EscapeDataString("Bomba Hidráulica")}");
    }


    private void Sair()
    {
        Nav.NavigateTo("/");
    }


    private async Task EnviarDados()
    {
        /*
         * ============================================================
         * 1. MONTA OS ITENS SELECIONADOS
         * ============================================================
         *
         * Essa lista ainda é utilizada para preencher o itens_json
         * da tabela solicitacoes.
         *
         * Durante a migração do sistema vamos manter o itens_json
         * para compatibilidade com as páginas antigas.
         *
         * A nova tabela solicitacao_itens será a responsável pelo
         * controle individual de cada peça.
         */

        var itensParaEnviar = pecas
            .Where(p =>
                !string.IsNullOrEmpty(p.SapPeca) &&
                quantidades.ContainsKey(p.SapPeca) &&
                quantidades[p.SapPeca] > 0)
                .Select(p => new ItemRequisicaoModel
                {
                    Sap = p.SapPeca!,
                    Descricao = p.Descricao!,
                    Quantidade = quantidades[p.SapPeca!],

                    // ========================================================
                    // VALOR
                    // DESATIVADO TEMPORARIAMENTE
                    //
                    // Mantido para utilização futura.
                    //
                    // Valor = p.Valor,
                    //
                    // ========================================================

                    Entregue = false
                })
            .ToList();


        /*
         * ============================================================
         * 2. VALIDAÇÃO
         * ============================================================
         */

        if (string.IsNullOrWhiteSpace(osNumero) ||
            !itensParaEnviar.Any())
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Por favor, preencha a O.S e adicione ao menos uma quantidade.");

            return;
        }


        isEnviando = true;


        try
        {
            /*
             * ========================================================
             * 3. CRIA A SOLICITAÇÃO PRINCIPAL
             * ========================================================
             *
             * Primeiro criamos o registro em:
             *
             * solicitacoes
             *
             * O ID gerado será utilizado pelos registros da tabela:
             *
             * solicitacao_itens
             */

            var solicitacao = new SolicitacaoCompletaModel
            {
                OsNumero = osNumero.Trim(),

                ModeloSolicitado = NomeModelo,

                /*
                 * Mantemos o JSON durante a migração.
                 *
                 * Futuramente ele poderá ser removido quando
                 * todas as páginas estiverem utilizando
                 * solicitacao_itens.
                 */
                ItensJson = itensParaEnviar,

                DataEnvio = DateTime.UtcNow,

                Status = "Pendente"
            };


            /*
             * Insere e recebe a resposta contendo o registro criado.
             */

            var respostaSolicitacao = await Supabase
                .From<SolicitacaoCompletaModel>()
                .Insert(solicitacao);


            /*
             * ========================================================
             * 4. RECUPERA O ID DA SOLICITAÇÃO
             * ========================================================
             */

            var solicitacaoCriada =
                respostaSolicitacao.Models.FirstOrDefault();


            if (solicitacaoCriada == null)
            {
                throw new Exception(
                    "A solicitação foi enviada, mas não foi possível obter o ID gerado.");
            }


            var itensBanco = itensParaEnviar
                .Select(item => new SolicitacaoItemModel
                {
                    SolicitacaoId = solicitacaoCriada.Id,

                    SapPeca = item.Sap,

                    Descricao = item.Descricao,

                    Quantidade = item.Quantidade,

                    // ========================================================
                    // VALOR
                    // DESATIVADO TEMPORARIAMENTE
                    //
                    // Mantido para utilização futura.
                    //
                    // Valor = item.Valor,
                    //
                    // ========================================================

                    Entregue = false
                })
                .ToList();


            /*
             * Insere todos os itens de uma vez.
             *
             * Isso é melhor do que realizar um INSERT separado
             * para cada peça.
             */

            if (itensBanco.Any())
            {
                await Supabase
                    .From<SolicitacaoItemModel>()
                    .Insert(itensBanco);
            }


            /*
             * ========================================================
             * 6. FINALIZA
             * ========================================================
             */

            await JS.InvokeVoidAsync(
                "alert",
                "Requisição enviada com sucesso!");


            Nav.NavigateTo("/");

        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao enviar: {ex.Message}");
        }
        finally
        {
            isEnviando = false;
        }
    }
}