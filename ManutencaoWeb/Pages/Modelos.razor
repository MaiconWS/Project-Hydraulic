@page "/modelos/{Categoria}"
@using ManutencaoWeb.Models
@inject Supabase.Client Supabase
@inject NavigationManager Nav

<div class="app-header">
    <h3>Modelos - @CategoriaDecodificada</h3>
</div>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2">Carregando componentes...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Erro ao carregar:</strong> @errorMessage
        </div>
    }
    else if (componentes == null || !componentes.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Nenhum componente encontrado para a categoria: <strong>@CategoriaDecodificada</strong>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in componentes)
            {
                <button class="list-group-item list-group-item-action d-flex align-items-center mb-2"
                        @onclick="@(() => IrParaChecklist(item.SapComp!, item.Modelo!))">
                    <div class="avatar-crr">CRR</div>
                    <div class="ms-3 flex-grow-1 text-start">
                        <h6 class="mb-0">@item.Modelo</h6>
                        <small class="text-muted">SAP: @item.SapComp</small>
                    </div>
                    <i class="oi oi-chevron-right text-muted"></i>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Categoria { get; set; }
    
    private string CategoriaDecodificada => Uri.UnescapeDataString(Categoria ?? "");
    private List<ComponenteModel> componentes = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // 1. Busca o ID do sistema que corresponde à categoria selecionada
            var sistemaResponse = await Supabase.From<SistemaModel>()
                .Filter("categoria", Postgrest.Constants.Operator.ILike, CategoriaDecodificada.Trim())
                .Get();

            var sistema = sistemaResponse.Models.FirstOrDefault();

            if (sistema != null)
            {
                // 2. Busca os componentes vinculados a esse sistema
                var componentesResponse = await Supabase.From<ComponenteModel>()
                    .Filter("sistema_id", Postgrest.Constants.Operator.Equals, sistema.Id)
                    .Get();

                componentes = componentesResponse.Models;
            }
            else
            {
                componentes = new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void IrParaChecklist(string sap, string modelo)
    {
        Nav.NavigateTo($"/checklist/{Uri.EscapeDataString(sap)}/{Uri.EscapeDataString(modelo)}");
    }
}