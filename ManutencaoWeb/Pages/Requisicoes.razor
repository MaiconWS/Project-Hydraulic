    // ============================================================
    // CALCULAR PERCENTUAL
    // ============================================================

    private int CalcularPorcentagem(
        SolicitacaoCompletaModel solicitacao)
    {
        if (!itensPorSolicitacao.TryGetValue(
                solicitacao.Id,
                out var itens))
        {
            return 0;
        }


        int total =
            itens.Sum(i => i.Quantidade);


        int entregues =
            itens
                .Where(i => i.Entregue)
                .Sum(i => i.Quantidade);


        return total > 0
            ? (int)((double)entregues / total * 100)
            : 0;
    }


    // ============================================================
    // SELECIONAR REQUISIÇÃO
    // ============================================================

    private void SelecionarRequisicao(long id)
    {
        // --------------------------------------------------------
        // Clicar novamente fecha os detalhes
        // --------------------------------------------------------

        if (requisicaoSelecionada?.Id == id)
        {
            requisicaoSelecionada = null;

            itensAtuais =
                new List<SolicitacaoItemModel>();

            return;
        }


        // --------------------------------------------------------
        // Localiza a solicitação
        // --------------------------------------------------------

        requisicaoSelecionada =
            solicitacoes.FirstOrDefault(
                s => s.Id == id
            );


        if (requisicaoSelecionada == null)
        {
            itensAtuais =
                new List<SolicitacaoItemModel>();

            return;
        }


        // --------------------------------------------------------
        // Carrega itens em memória
        // --------------------------------------------------------

        if (itensPorSolicitacao.TryGetValue(
                id,
                out var itens))
        {
            itensAtuais = itens;
        }
        else
        {
            itensAtuais =
                new List<SolicitacaoItemModel>();
        }
    }


    // ============================================================
    // ALTERNAR ENTRE ENTREGUE / PENDENTE
    // ============================================================

    private async Task AlternarEntrega(
        SolicitacaoItemModel item)
    {
        bool estadoAnterior =
            item.Entregue;


        try
        {
            // ----------------------------------------------------
            // Altera visualmente
            // ----------------------------------------------------

            item.Entregue =
                !estadoAnterior;


            // ----------------------------------------------------
            // Salva no banco
            // ----------------------------------------------------

            await Supabase
                .From<SolicitacaoItemModel>()
                .Where(i => i.Id == item.Id)
                .Update(item);


            // ----------------------------------------------------
            // Atualiza memória
            // ----------------------------------------------------

            if (itensPorSolicitacao.TryGetValue(
                    item.SolicitacaoId,
                    out var lista))
            {
                var itemMemoria =
                    lista.FirstOrDefault(
                        i => i.Id == item.Id
                    );


                if (itemMemoria != null)
                {
                    itemMemoria.Entregue =
                        item.Entregue;
                }
            }


            StateHasChanged();
        }
        catch (Exception ex)
        {
            // ----------------------------------------------------
            // Reverte se houver erro
            // ----------------------------------------------------

            item.Entregue =
                estadoAnterior;


            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao salvar alteração da entrega: {ex.Message}"
            );
        }
    }


