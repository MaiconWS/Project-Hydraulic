@page "/requisicoes"
@using ManutencaoWeb.Models
@using ManutencaoWeb.Services
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SessaoService Sessao

<PageTitle>Requisições - ManutencaoWeb</PageTitle>

<div class="dashboard-wrapper">

    <!-- =========================================================
         SIDEBAR
         ========================================================= -->
    <nav class="sidebar @(isMenuOpen ? "mobile-open" : "")">

        <div class="sidebar-brand">
            <i class="bi bi-gear-wide">
                <span> Manutenção WEB</span>
            </i>
        </div>

        <ul class="sidebar-menu">

            <li>
                <a href="/">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>

            <li class="active">
                <a href="/requisicoes">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Requisições</span>
                </a>
            </li>

            <li>
                <a href="/relatorios">
                    <i class="bi bi-bar-chart"></i>
                    <span>Relatórios</span>
                </a>
            </li>

            <li>
                <a href="/liberados">
                    <i class="bi bi-wrench-adjustable"></i>
                    <span>Liberados</span>
                </a>
            </li>

            @if (Sessao.IsAdmin)
            {
                <li>
                    <a href="/admin">
                        <i class="bi bi-plus-square"></i>
                        <span>Cadastros Base</span>
                    </a>
                </li>
            }

        </ul>

        <div class="sidebar-footer">

            <div class="d-flex align-items-center gap-2 mb-3 px-2">

                <div class="user-avatar">
                    @(Sessao.Iniciais)
                </div>

                <div style="font-size: 12px; color: #cfdcd4;">
                    <strong>@Sessao.NomeUsuario</strong><br />
                </div>

            </div>

            <button class="btn-sair" @onclick="Sair">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sair</span>
            </button>

        </div>

    </nav>


    <!-- =========================================================
         CONTEÚDO PRINCIPAL
         ========================================================= -->
    <main class="main-content">

        <!-- TOP BAR -->
        <header class="top-bar">

            <div class="top-bar-left d-flex align-items-center">

                <button class="menu-toggle d-md-none me-2"
                        @onclick="ToggleMenu">

                    <i class="bi bi-list"></i>

                </button>

                <span class="user-greeting">
                    Olá, <strong>@Sessao.NomeUsuario!</strong><br />
                </span>

            </div>

            <div class="top-bar-right">

                <div class="user-avatar">
                    @(Sessao.Iniciais)
                </div>

            </div>

        </header>


        <!-- =========================================================
             CORPO
             ========================================================= -->
        <div class="content-body">

            <!-- TÍTULO -->
            <div class="d-flex align-items-start mb-4 gap-3">

                <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                        style="width: 42px; height: 42px; background: #fff; border-color: #dee2e6;"
                        @onclick="Sair">

                    <i class="bi bi-arrow-left text-dark"></i>

                </button>

                <div class="section-title mb-0">

                    <h2 class="mb-1"
                        style="color: #2c3e50; font-weight: 700;">

                        Controle de Requisições

                    </h2>

                    <p class="text-muted mb-0">

                        Acompanhe e atualize a entrega dos componentes
                        solicitados por Ordem de Serviço.

                    </p>

                </div>

            </div>


            <!-- =====================================================
                 LOADING
                 ===================================================== -->
            @if (isLoading)
            {
                <div class="text-center py-5">

                    <div class="spinner-border text-success"
                         role="status">

                    </div>

                    <div class="mt-3 text-muted">
                        Carregando requisições...
                    </div>

                </div>
            }

            else if (solicitacoes == null || !solicitacoes.Any())
            {
                <div class="alert alert-info">

                    <i class="bi bi-info-circle me-2"></i>

                    Nenhuma requisição pendente encontrada
                    no banco de dados.

                </div>
            }

            else
            {

                <!-- =================================================
                     BUSCA
                     ================================================= -->
                <div class="card border-0 shadow-sm p-4 mb-4">

                    <label class="fw-bold mb-2">

                        Informe a Ordem de Serviço

                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Busque por O.S ou Modelo de componente"
                           @bind="termoBusca"
                           @bind:event="oninput" />

                </div>


                <!-- =================================================
                     TABELA MASTER
                     ================================================= -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="table-responsive">

                        <table class="table align-middle mb-0 table-hover">

                            <thead class="bg-success text-white">

                                <tr>

                                    <th class="ps-4 py-3">
                                        O.S
                                    </th>

                                    <th class="py-3">
                                        Componente
                                    </th>

                                    <th class="py-3"
                                        style="width: 180px;">

                                        Progresso

                                    </th>

                                    <th class="pe-4 py-3 text-end">
                                        Ação
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var s in SolicitacoesFiltradas)
                                {
                                    int pct = CalcularPorcentagem(s);

                                    bool isSelected =
                                        requisicaoSelecionada?.Id == s.Id;

                                    <tr style="
                                            cursor:pointer;
                                            background-color:@(
                                                isSelected
                                                    ? "#f1f8f5"
                                                    : "transparent"
                                            );"
                                        @onclick="() => SelecionarRequisicao(s.Id)">

                                        <td class="ps-4 text-muted">

                                            O.S.: @s.OsNumero

                                        </td>

                                        <td class="fw-bold text-secondary">

                                            @s.ModeloSolicitado

                                        </td>

                                        <td>

                                            <div class="d-flex align-items-center gap-2">

                                                <span style="min-width:45px;">
                                                    @pct%
                                                </span>

                                                <div class="progress flex-grow-1"
                                                     style="
                                                         height:6px;
                                                         background-color:#e9ecef;
                                                     ">

                                                    <div class="progress-bar bg-success"
                                                         style="width:@pct%;">
                                                    </div>

                                                </div>

                                            </div>

                                        </td>

                                        <td class="pe-4 text-end">

                                            <button class="btn btn-sm @(isSelected
                                                        ? "btn-success"
                                                        : "btn-outline-success")">

                                                @(isSelected
                                                    ? "Editando..."
                                                    : "Ver Itens")

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     DETALHES DA REQUISIÇÃO
                     ================================================= -->
                @if (requisicaoSelecionada != null)
                {
                    <div class="mt-5 p-3 rounded"
                         style="
                             background-color:#f8f9fa;
                             border-left:4px solid #198754;
                         ">

                        <!-- CABEÇALHO -->
                        <div class="d-flex justify-content-between
                                    align-items-center mb-4">

                            <h4 class="mb-0">

                                Itens da
                                <strong>
                                    O.S.: @requisicaoSelecionada.OsNumero
                                </strong>

                            </h4>

                            <!-- ADICIONAR PEÇA -->
                            <button class="btn btn-success"
                                    @onclick="AbrirModalAdicionarPeca">

                                <i class="bi bi-plus-lg me-1"></i>

                                Adicionar peça

                            </button>

                        </div>


                        <!-- =================================================
                             CARDS
                             ================================================= -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <div class="card border-0 shadow-sm p-3
                                            bg-white h-100">

                                    <small class="text-muted">
                                        Modelo
                                    </small>

                                    <h6 class="mb-0 fw-bold">

                                        @requisicaoSelecionada.ModeloSolicitado

                                    </h6>

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="card border-0 shadow-sm p-3
                                            bg-white h-100">

                                    <small class="text-muted">
                                        Progresso
                                    </small>

                                    <h6 class="mb-0 fw-bold">

                                        @ItensEntregues de @TotalItens

                                    </h6>

                                    <small class="text-success">

                                        @PorcentagemConcluida% concluído

                                    </small>

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="card border-0 shadow-sm p-3
                                            bg-white h-100">

                                    <small class="text-muted">
                                        Situação
                                    </small>

                                    @if (TodosItensEntregues)
                                    {
                                        <h6 class="mb-0 text-success fw-bold">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Todos entregues

                                        </h6>
                                    }
                                    else
                                    {
                                        <h6 class="mb-0 text-warning fw-bold">

                                            <i class="bi bi-clock-fill me-1"></i>

                                            Aguardando peças

                                        </h6>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             TABELA DE ITENS
                             ================================================= -->
                        <div class="card border-0 shadow-sm mb-4">

                            <div class="table-responsive">

                                <table class="table align-middle mb-0">

                                    <thead class="bg-secondary text-white">

                                        <tr>

                                            <th class="ps-4">
                                                SAP
                                            </th>

                                            <th>
                                                Componente
                                            </th>

                                            @*<th>
                                                Valor (R$)
                                            </th>*@

                                            <th>
                                                Quantidade
                                            </th>

                                            <th class="text-center pe-4">
                                                Entregue
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @if (itensAtuais == null ||
                                             !itensAtuais.Any())
                                        {
                                            <tr>

                                                <td colspan="5"
                                                    class="text-center py-4 text-muted">

                                                    Nenhuma peça cadastrada
                                                    para esta requisição.

                                                </td>

                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in itensAtuais)
                                            {
                                                <tr>

                                                    <!-- SAP -->
                                                    <td class="ps-4 fw-bold text-secondary">

                                                        @item.SapPeca

                                                    </td>


                                                    <!-- DESCRIÇÃO -->
                                                    <td>

                                                        @item.Descricao

                                                    </td>


                                                    <!-- VALOR -->
                                                    @*<td>

                                                        R$
                                                        @item.Valor.ToString("F2")

                                                    </td>*@


                                                    <!-- QUANTIDADE -->
                                                    <td>

                                                        <div class="
                                                            d-inline-flex
                                                            align-items-center
                                                            border
                                                            rounded
                                                            bg-light
                                                            px-2
                                                            py-1">

                                                            <span>
                                                                @item.Quantidade
                                                            </span>

                                                        </div>

                                                    </td>


                                                    <!-- CHECK ENTREGUE -->
                                                    <td class="text-center pe-4">

                                                        <button type="button"
                                                                class="btn @(item.Entregue
                                                                    ? "btn-success"
                                                                    : "btn-outline-secondary")
                                                                    btn-sm px-3"
                                                                @onclick="() => AlternarEntrega(item)"
                                                                title="@(item.Entregue
                                                                    ? "Marcar como pendente"
                                                                    : "Marcar como entregue")">

                                                            @if (item.Entregue)
                                                            {
                                                                <i class="bi bi-check-lg"></i>
                                                                <span class="ms-1">
                                                                    Entregue
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-square"></i>
                                                                <span class="ms-1">
                                                                    Pendente
                                                                </span>
                                                            }

                                                        </button>

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- =================================================
                             RESUMO E AÇÕES
                             ================================================= -->
                        <div class="card border-0 shadow-sm p-4
                                    bg-white mb-2">

                            <div class="row align-items-center g-3">

                                <!-- RESUMO -->
                                <div class="col-md-5">

                                    <small class="text-muted d-block">

                                        Resumo da seleção

                                    </small>

                                    @if (TotalItens == 0)
                                    {
                                        <strong>
                                            Nenhum item cadastrado
                                        </strong>
                                    }
                                    else if (TodosItensEntregues)
                                    {
                                        <strong class="text-success">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Todos os @TotalItens itens
                                            foram entregues

                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>

                                            @(TotalItens - ItensEntregues)
                                            itens faltantes de
                                            @TotalItens componentes

                                        </strong>
                                    }

                                </div>


                                <!-- VALOR -->
                                <div class="col-md-3">

                                    <small class="text-muted d-block">

                                        Total estimado

                                    </small>

                                    <h4 class="text-success fw-bold mb-0">

                                        R$ -
                                       @* @ValorTotalEstimado.ToString("F2")*@

                                    </h4>

                                </div>


                                <!-- CONDENAR -->
                                <div class="col-md-2">

                                    <button type="button"
                                            class="btn btn-outline-danger
                                                   w-100
                                                   py-2
                                                   fw-bold"
                                            @onclick="CondenarProducao">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Condenar

                                    </button>

                                </div>


                                <!-- LIBERAR -->
                                <div class="col-md-2">

                                    <button type="button"
                                            class="btn btn-success
                                                   w-100
                                                   py-2
                                                   fw-bold"
                                            disabled="@(!TodosItensEntregues)"
                                            @onclick="LiberarProducao"
                                            title="@(
                                                TodosItensEntregues
                                                    ? "Liberar produção"
                                                    : "É necessário entregar todos os itens"
                                            )">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Liberar

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            }

        </div>

    </main>

</div>


<!-- =============================================================
     MODAL - ADICIONAR PEÇA
     ============================================================= -->
@if (mostrarModalAdicionarPeca)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <!-- CABEÇALHO -->
                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-plus-circle me-2 text-success"></i>

                        Adicionar peça

                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="FecharModalAdicionarPeca">
                    </button>

                </div>


                <!-- CORPO -->
                <div class="modal-body">

                    <div class="alert alert-light border">

                        <small class="text-muted">
                            O.S.
                        </small>

                        <div class="fw-bold">
                            @requisicaoSelecionada?.OsNumero
                        </div>

                    </div>


                    <!-- SAP -->
                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            SAP da peça

                        </label>

                        <div class="input-group">

                            <input type="text"
                                   class="form-control"
                                   placeholder="Digite o SAP"
                                   @bind="sapPecaBusca" />

                            <button type="button"
                                    class="btn btn-outline-success"
                                    @onclick="BuscarPeca"
                                    disabled="@buscandoPeca">

                                @if (buscandoPeca)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-search"></i>
                                }

                            </button>

                        </div>

                    </div>


                    <!-- RESULTADO -->
                    @if (pecaEncontrada != null)
                    {
                        <div class="card border-success mb-3">

                            <div class="card-body">

                                <small class="text-muted">
                                    Peça encontrada
                                </small>

                                <h6 class="fw-bold mb-1">

                                    @pecaEncontrada.SapPeca

                                </h6>

                                <p class="mb-0 text-secondary">

                                    @pecaEncontrada.Descricao

                                </p>

                                <div class="mt-2 text-success fw-bold">

                                    R$
                                    @pecaEncontrada.Valor.ToString("F2")

                                </div>

                            </div>

                        </div>
                    }


                    <!-- MENSAGEM -->
                    @if (!string.IsNullOrWhiteSpace(mensagemModal))
                    {
                        <div class="alert @(
                            mensagemModalErro
                                ? "alert-danger"
                                : "alert-info"
                        )">

                            @mensagemModal

                        </div>
                    }


                    <!-- QUANTIDADE -->
                    @if (pecaEncontrada != null)
                    {
                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Quantidade

                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="1"
                                   @bind="quantidadeNovaPeca" />

                        </div>
                    }

                </div>


                <!-- RODAPÉ -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="FecharModalAdicionarPeca">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-success"
                            disabled="@(pecaEncontrada == null || salvandoPeca)"
                            @onclick="AdicionarPeca">

                        @if (salvandoPeca)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>

                             <span>Adicionando...</span>
                        }
                        else
                        {
                            <i class="bi bi-plus-lg me-1"></i>

                            <span>Adicionar peça</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    // ============================================================
    // MENU MOBILE
    // ============================================================

    private bool isMenuOpen = false;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }


    // ============================================================
    // ESTADO DA PÁGINA
    // ============================================================

    private List<SolicitacaoCompletaModel> solicitacoes = new();

    private SolicitacaoCompletaModel? requisicaoSelecionada;

    // NOVA ARQUITETURA:
    // Os itens agora vêm da tabela solicitacao_itens.
    private List<SolicitacaoItemModel> itensAtuais = new();

    private bool isLoading = true;


    private Dictionary<long, List<SolicitacaoItemModel>> itensPorSolicitacao
        = new();


    // ============================================================
    // BUSCA
    // ============================================================

    private string termoBusca = "";

    private IEnumerable<SolicitacaoCompletaModel> SolicitacoesFiltradas =>
        string.IsNullOrWhiteSpace(termoBusca)
            ? solicitacoes
            : solicitacoes.Where(s =>
                (s.OsNumero != null &&
                 s.OsNumero.Contains(
                     termoBusca,
                     StringComparison.OrdinalIgnoreCase))

                ||

                (s.ModeloSolicitado != null &&
                 s.ModeloSolicitado.Contains(
                     termoBusca,
                     StringComparison.OrdinalIgnoreCase))
            );


    // ============================================================
    // PROPRIEDADES DOS ITENS
    // ============================================================

    private int TotalItens =>
        itensAtuais.Sum(i => i.Quantidade);


    private int ItensEntregues =>
        itensAtuais
            .Where(i => i.Entregue)
            .Sum(i => i.Quantidade);


    private int PorcentagemConcluida =>
        TotalItens > 0
            ? (int)((double)ItensEntregues / TotalItens * 100)
            : 0;


    private bool TodosItensEntregues =>
        TotalItens > 0 &&
        ItensEntregues == TotalItens;


    // ============================================================
    // VALOR TOTAL
    // ============================================================

    private double ValorTotalEstimado =>
        itensAtuais.Sum(i => i.Quantidade * i.Valor);


    // ============================================================
    // MODAL ADICIONAR PEÇA
    // ============================================================

    private bool mostrarModalAdicionarPeca = false;

    private string sapPecaBusca = "";

    private int quantidadeNovaPeca = 1;

    private bool buscandoPeca = false;

    private bool salvandoPeca = false;

    private PecaModel? pecaEncontrada;

    private string mensagemModal = "";

    private bool mensagemModalErro = false;


    // ============================================================
    // INICIALIZAÇÃO
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await CarregarRequisicoes();
    }


    // ============================================================
    // CARREGAR REQUISIÇÕES
    // ============================================================

    private async Task CarregarRequisicoes()
    {
        try
        {
            isLoading = true;

            // ========================================================
            // 1. CARREGA AS O.S. PENDENTES
            // ========================================================

            var response =
                await Supabase
                    .From<SolicitacaoCompletaModel>()
                    .Filter(
                        "status",
                        Postgrest.Constants.Operator.Equals,
                        "Pendente"
                    )
                    .Get();

            solicitacoes = response.Models;


            // ========================================================
            // 2. CARREGA TODOS OS ITENS DA NOVA TABELA
            // ========================================================

            var itensResponse =
                await Supabase
                    .From<SolicitacaoItemModel>()
                    .Get();


            // ========================================================
            // 3. AGRUPA OS ITENS PELO ID DA SOLICITAÇÃO
            // ========================================================

            itensPorSolicitacao =
                itensResponse.Models
                    .GroupBy(i => i.SolicitacaoId)
                    .ToDictionary(
                        g => g.Key,
                        g => g.ToList()
                    );


            // ========================================================
            // 4. LIMPA A SELEÇÃO ATUAL
            // ========================================================

            requisicaoSelecionada = null;

            itensAtuais =
                new List<SolicitacaoItemModel>();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao carregar requisições: {ex.Message}"
            );
        }
        finally
        {
            isLoading = false;
        }
    }


    // ============================================================
    // CALCULAR PERCENTUAL
    // ============================================================

    private int CalcularPorcentagem(
        SolicitacaoCompletaModel solicitacao)
    {
        // ========================================================
        // Procura os itens dessa O.S.
        // ========================================================

        if (!itensPorSolicitacao.TryGetValue(
                solicitacao.Id,
                out var itens))
        {
            return 0;
        }


        // ========================================================
        // Quantidade total
        // ========================================================

        int total =
            itens.Sum(i => i.Quantidade);


        // ========================================================
        // Quantidade entregue
        // ========================================================

        int entregues =
            itens
                .Where(i => i.Entregue)
                .Sum(i => i.Quantidade);


        // ========================================================
        // Percentual
        // ========================================================

        return total > 0
            ? (int)((double)entregues / total * 100)
            : 0;
    }


    // ============================================================
    // SELECIONAR REQUISIÇÃO
    // ============================================================

    private void SelecionarRequisicao(long id)
    {
        // ========================================================
        // Se clicar novamente na mesma O.S., fecha os detalhes
        // ========================================================

        if (requisicaoSelecionada?.Id == id)
        {
            requisicaoSelecionada = null;

            itensAtuais =
                new List<SolicitacaoItemModel>();

            return;
        }


        // ========================================================
        // Localiza a solicitação
        // ========================================================

        requisicaoSelecionada =
            solicitacoes.FirstOrDefault(s => s.Id == id);


        if (requisicaoSelecionada == null)
        {
            itensAtuais =
                new List<SolicitacaoItemModel>();

            return;
        }


        // ========================================================
        // Pega os itens já carregados em memória
        // ========================================================

        if (itensPorSolicitacao.TryGetValue(
                id,
                out var itens))
        {
            itensAtuais = itens;
        }
        else
        {
            itensAtuais =
                new List<SolicitacaoItemModel>();
        }
    }


    // ============================================================
    // ALTERNAR ENTRE ENTREGUE / PENDENTE
    // ============================================================

    private async Task AlternarEntrega(
        SolicitacaoItemModel item)
    {
        bool estadoAnterior =
            item.Entregue;

        try
        {
            // ========================================================
            // ALTERA O CHECK
            // ========================================================

            item.Entregue =
                !estadoAnterior;


            // ========================================================
            // SALVA SOMENTE ESTE ITEM
            // ========================================================

            await Supabase
                .From<SolicitacaoItemModel>()
                .Where(i => i.Id == item.Id)
                .Update(item);


            // ========================================================
            // ATUALIZA O DICIONÁRIO EM MEMÓRIA
            // ========================================================

            if (itensPorSolicitacao.TryGetValue(
                    item.SolicitacaoId,
                    out var lista))
            {
                var itemMemoria =
                    lista.FirstOrDefault(i => i.Id == item.Id);

                if (itemMemoria != null)
                {
                    itemMemoria.Entregue =
                        item.Entregue;
                }
            }


            StateHasChanged();
        }
        catch (Exception ex)
        {
            // ========================================================
            // SE DER ERRO, REVERTE
            // ========================================================

            item.Entregue =
                estadoAnterior;

            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao salvar alteração da entrega: {ex.Message}"
            );
        }
    }


    // ============================================================
    // ABRIR MODAL
    // ============================================================

    private void AbrirModalAdicionarPeca()
    {
        sapPecaBusca = "";

        quantidadeNovaPeca = 1;

        pecaEncontrada = null;

        mensagemModal = "";

        mensagemModalErro = false;

        mostrarModalAdicionarPeca = true;
    }


    // ============================================================
    // FECHAR MODAL
    // ============================================================

    private void FecharModalAdicionarPeca()
    {
        mostrarModalAdicionarPeca = false;

        sapPecaBusca = "";

        quantidadeNovaPeca = 1;

        pecaEncontrada = null;

        mensagemModal = "";

        mensagemModalErro = false;
    }


    // ============================================================
    // BUSCAR PEÇA
    // ============================================================

    private async Task BuscarPeca()
    {
        mensagemModal = "";

        mensagemModalErro = false;

        pecaEncontrada = null;


        if (string.IsNullOrWhiteSpace(sapPecaBusca))
        {
            mensagemModal =
                "Informe o SAP da peça.";

            mensagemModalErro = true;

            return;
        }


        try
        {
            buscandoPeca = true;


            // ----------------------------------------------------
            // Busca exata na tabela pecas
            // ----------------------------------------------------

            var response =
                await Supabase
                    .From<PecaModel>()
                    .Filter(
                        "sap_peca",
                        Postgrest.Constants.Operator.Equals,
                        sapPecaBusca.Trim()
                    )
                    .Get();


            pecaEncontrada =
                response.Models.FirstOrDefault();


            if (pecaEncontrada == null)
            {
                mensagemModal =
                    "Nenhuma peça encontrada com este SAP.";

                mensagemModalErro = true;
            }
        }
        catch (Exception ex)
        {
            mensagemModal =
                $"Erro ao buscar peça: {ex.Message}";

            mensagemModalErro = true;
        }
        finally
        {
            buscandoPeca = false;
        }
    }


    // ============================================================
    // ADICIONAR PEÇA
    // ============================================================

    private async Task AdicionarPeca()
    {
        mensagemModal = "";

        mensagemModalErro = false;


        if (requisicaoSelecionada == null)
        {
            mensagemModal =
                "Nenhuma requisição selecionada.";

            mensagemModalErro = true;

            return;
        }


        if (pecaEncontrada == null)
        {
            mensagemModal =
                "Busque uma peça antes de adicionar.";

            mensagemModalErro = true;

            return;
        }


        if (quantidadeNovaPeca <= 0)
        {
            mensagemModal =
                "Informe uma quantidade válida.";

            mensagemModalErro = true;

            return;
        }


        // --------------------------------------------------------
        // Verificação visual de duplicidade
        // --------------------------------------------------------

        bool jaExiste =
            itensAtuais.Any(i =>
                string.Equals(
                    i.SapPeca?.Trim(),
                    pecaEncontrada.SapPeca?.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
            );


        if (jaExiste)
        {
            mensagemModal =
                "Esta peça já está cadastrada nesta O.S.";

            mensagemModalErro = true;

            return;
        }


        try
        {
            salvandoPeca = true;


            // ----------------------------------------------------
            // Cria uma nova linha na tabela solicitacao_itens
            // ----------------------------------------------------

            var novoItem =
                new SolicitacaoItemModel
                {
                    SolicitacaoId =
                        requisicaoSelecionada.Id,

                    SapPeca =
                        pecaEncontrada.SapPeca,

                    Descricao =
                        pecaEncontrada.Descricao,

                    Quantidade =
                        quantidadeNovaPeca,

                    Valor =
                        pecaEncontrada.Valor,

                    // Peça nova começa como NÃO ENTREGUE
                    Entregue = false
                };


            // ----------------------------------------------------
            // INSERT
            // ----------------------------------------------------

            var response =
                await Supabase
                    .From<SolicitacaoItemModel>()
                    .Insert(novoItem);


            // ----------------------------------------------------
            // Pega o objeto criado pelo banco
            // ----------------------------------------------------

            var itemInserido =
                response.Models.FirstOrDefault();


            if (itemInserido != null)
            {
                itensAtuais.Add(itemInserido);
            }
            else
            {
                // ------------------------------------------------
                // Fallback caso a resposta não retorne o registro
                // ------------------------------------------------

                var itensResponse =
                    await Supabase
                        .From<SolicitacaoItemModel>()
                        .Filter(
                            "solicitacao_id",
                            Postgrest.Constants.Operator.Equals,
                            requisicaoSelecionada.Id.ToString()
                        )
                        .Get();

                itensAtuais =
                    itensResponse.Models;
            }


            mensagemModal =
                "Peça adicionada com sucesso.";


            mensagemModalErro = false;


            // ----------------------------------------------------
            // Limpa campos para uma nova inclusão
            // ----------------------------------------------------

            sapPecaBusca = "";

            quantidadeNovaPeca = 1;

            pecaEncontrada = null;


            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensagemModal =
                $"Erro ao adicionar peça: {ex.Message}";

            mensagemModalErro = true;
        }
        finally
        {
            salvandoPeca = false;
        }
    }


    // ============================================================
    // LIBERAR PRODUÇÃO
    // ============================================================

    private async Task LiberarProducao()
    {
        if (requisicaoSelecionada == null)
            return;


        // --------------------------------------------------------
        // Segurança adicional:
        // não permite liberar enquanto existir item pendente
        // --------------------------------------------------------

        if (!TodosItensEntregues)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Não é possível liberar a produção. Existem peças pendentes."
            );

            return;
        }


        try
        {
            // ----------------------------------------------------
            // Atualiza somente o status da solicitação
            // ----------------------------------------------------

            requisicaoSelecionada.Status =
                "Liberado";


            await Supabase
                .From<SolicitacaoCompletaModel>()
                .Where(s =>
                    s.Id == requisicaoSelecionada.Id)
                .Update(requisicaoSelecionada);


            await JS.InvokeVoidAsync(
                "alert",
                "Produção liberada com sucesso! A O.S. foi removida desta tela."
            );


            await CarregarRequisicoes();

            termoBusca = "";
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao liberar produção: {ex.Message}"
            );
        }
    }


    // ============================================================
    // CONDENAR
    // ============================================================

    private async Task CondenarProducao()
    {
        if (requisicaoSelecionada == null)
            return;


        bool confirmado =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Tem certeza que deseja marcar esta requisição como Condenada?"
            );


        if (!confirmado)
            return;


        try
        {
            requisicaoSelecionada.Status =
                "Condenado";


            await Supabase
                .From<SolicitacaoCompletaModel>()
                .Where(s =>
                    s.Id == requisicaoSelecionada.Id)
                .Update(requisicaoSelecionada);


            await JS.InvokeVoidAsync(
                "alert",
                "Requisição marcada como Condenada com sucesso! A O.S. foi removida desta tela."
            );


            await CarregarRequisicoes();

            termoBusca = "";
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao condenar requisição: {ex.Message}"
            );
        }
    }


