    // ============================================================
    // CARREGAR REQUISIÇÕES
    // ============================================================

    private async Task CarregarRequisicoes()
    {
        try
        {
            isLoading = true;


            // ========================================================
            // 1. CARREGA AS O.S. PENDENTES
            // ========================================================

            var response =
                await Supabase
                    .From<SolicitacaoCompletaModel>()
                    .Filter(
                        "status",
                        Postgrest.Constants.Operator.Equals,
                        "Pendente"
                    )
                    .Get();

            solicitacoes = response.Models;


            // ========================================================
            // 2. CARREGA TODOS OS ITENS
            // ========================================================

            var itensResponse =
                await Supabase
                    .From<SolicitacaoItemModel>()
                    .Get();


            // ========================================================
            // 3. AGRUPA OS ITENS PELO ID DA SOLICITAÇÃO
            // ========================================================

            itensPorSolicitacao =
                itensResponse.Models
                    .GroupBy(i => i.SolicitacaoId)
                    .ToDictionary(
                        g => g.Key,
                        g => g.ToList()
                    );


            // ========================================================
            // 4. CARREGA OS COMPONENTES
            // ========================================================

            var componentesResponse =
                await Supabase
                    .From<ComponenteModel>()
                    .Get();

            var componentes =
                componentesResponse.Models;


            // ========================================================
            // 5. CARREGA OS SISTEMAS
            // ========================================================

            var sistemasResponse =
                await Supabase
                    .From<SistemaModel>()
                    .Get();

            var sistemas =
                sistemasResponse.Models;


            // ========================================================
            // 6. MONTA MODELO → SISTEMA
            // ========================================================

            sistemaPorModelo.Clear();

            foreach (var componente in componentes)
            {
                if (string.IsNullOrWhiteSpace(componente.Modelo))
                    continue;


                var sistema =
                    sistemas.FirstOrDefault(
                        s => s.Id == componente.SistemaId
                    );


                if (sistema == null)
                    continue;


                if (string.IsNullOrWhiteSpace(sistema.Categoria))
                    continue;


                if (!sistemaPorModelo.ContainsKey(
                        componente.Modelo))
                {
                    sistemaPorModelo.Add(
                        componente.Modelo,
                        sistema.Categoria
                    );
                }
            }


            // ========================================================
            // 7. MONTA LISTA DO SELECT
            // ========================================================

            sistemasDisponiveis =
                sistemas
                    .Where(s =>
                        !string.IsNullOrWhiteSpace(
                            s.Categoria
                        )
                    )
                    .Select(s => s.Categoria!)
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase
                    )
                    .OrderBy(s => s)
                    .ToList();


            // ========================================================
            // 8. LIMPA SELEÇÃO
            // ========================================================

            requisicaoSelecionada = null;

            itensAtuais =
                new List<SolicitacaoItemModel>();

        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Erro ao carregar requisições: {ex.Message}"
            );
        }
        finally
        {
            isLoading = false;
        }
    }


    // ============================================================
    // OBTER SISTEMA DO MODELO
    // ============================================================

    private string ObterSistemaDoModelo(
        string? modelo)
    {
        if (string.IsNullOrWhiteSpace(modelo))
            return "";


        if (sistemaPorModelo.TryGetValue(
                modelo,
                out var sistema))
        {
            return sistema;
        }


        return "";
    }


